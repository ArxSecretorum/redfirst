#!/bin/sh
# redfirst — deterministic checkpoints for AI-assisted development.
#
# Every subcommand ends in an artifact a non-reader can judge: a count with its
# breakdown, samples of what was counted, or an overdue date. Nothing here
# reports "I checked, it's fine".
#
# Design rule earned the hard way: when this tool is unsure, it must fail LOUD
# (report a problem) and never fail SILENT (report all-clear). Version 0.1.0
# failed silent in twenty places — an unparseable date, an unknown project
# layout and a symbol containing a dot all produced a confident green.
#
# No dependencies beyond POSIX sh, grep, find, sed. No network. No self-update.
set -eu
# Character classes below are locale-sensitive: without a UTF-8 locale
# [[:alnum:]] degrades to ASCII and a Cyrillic symbol matches inside a longer
# identifier. Verified failure, not a precaution.
LC_ALL="${LC_ALL:-C.UTF-8}"; export LC_ALL

set -f          # globbing off: an unquoted mask like *.kt would otherwise be
                # expanded by the shell against the current directory before
                # find ever sees it, silently limiting every scan to the root.

VERSION="0.5.0"
CONFIG_DIR="${REDFIRST_DIR:-.redfirst}"
ASSETS="$CONFIG_DIR/irreplaceable"
SOURCES="$CONFIG_DIR/sources"
MAX_SYMBOL=200          # guards the quadratic blowup on absurd input
TMP=""

cleanup() { rm -rf "$TMP" 2>/dev/null || true; }
trap cleanup EXIT INT TERM
TMP=$(mktemp -d "${TMPDIR:-/tmp}/redfirst.XXXXXX") || {
    printf 'redfirst: не удалось создать временный каталог
' >&2; exit 2; }

# Deliberate defects, for the regression suite's self-check. A suite that
# cannot be shown to go red proves nothing - the same "green proves nothing"
# this tool exists to fight, one level up. Guarded twice so it cannot fire
# in production.
_broken() {
    [ "${REDFIRST_SELFTEST:-}" = "1" ] || return 1
    [ "${REDFIRST_BREAK:-}" = "$1" ]
}

die()  { printf '%s\n' "redfirst: $*" >&2; exit 2; }
warn() { printf '%s\n' "redfirst: $*" >&2; }

# Strip UTF-8 BOM and CR. Config files get edited in Windows editors; a trailing
# \r turned "30" into "30\r" and disabled the check for that asset entirely.
# The BOM is removed by parameter expansion rather than sed: octal escapes are
# not portable across sed implementations and GNU sed read \357 as a back
# reference, which broke every line instead of cleaning it.
BOM=$(printf '\357\273\277')
clean_line() {
    l=${1#"$BOM"}
    printf '%s' "$l" | tr -d '\r'
}

trim() { printf '%s' "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }

# Escape every ERE metacharacter so a symbol is matched literally.
# `auth.login` used to match `auth_login`.
esc_ere() { printf '%s' "$1" | sed 's/[][\\.*^$(){}?+|]/\\&/g'; }

# Word boundary defined explicitly rather than via grep -w, which treats
# non-ASCII bytes as non-word characters and so matched Cyrillic identifiers
# inside longer ones.
bound() { printf '(^|[^[:alnum:]_])%s([^[:alnum:]_]|$)' "$1"; }

# ── source discovery ─────────────────────────────────────────────────────────

source_patterns() {
    if [ -f "$SOURCES" ]; then
        pats=$(grep -v '^[[:space:]]*#' "$SOURCES" 2>/dev/null | grep -v '^[[:space:]]*$' || true)
        [ -n "$pats" ] && { printf '%s\n' "$pats"; return; }
        warn "$SOURCES пуст или состоит из комментариев — использую автоопределение"
    fi
    found=""
    [ -f build.gradle.kts ] || [ -f build.gradle ] || [ -f settings.gradle.kts ] && found="*.kt *.java *.kts"
    [ -f pyproject.toml ] || [ -f setup.py ] || [ -f requirements.txt ] && found="$found *.py"
    [ -f package.json ] && found="$found *.ts *.tsx *.js *.jsx *.mjs *.cjs *.svelte *.vue"
    [ -f Cargo.toml ] && found="$found *.rs"
    [ -f go.mod ] && found="$found *.go"
    [ -f pom.xml ] || [ -f build.xml ] && found="$found *.java"
    find . -maxdepth 1 \( -name '*.csproj' -o -name '*.sln' \) 2>/dev/null | grep -q . && found="$found *.cs"
    [ -f Gemfile ] && found="$found *.rb"
    [ -f composer.json ] && found="$found *.php"
    if [ -z "$(trim "$found")" ]; then
        # No marker: scan every extension we know rather than '*', which used to
        # drag in binaries and lock files and slow everything to a crawl.
        found="*.kt *.java *.py *.ts *.tsx *.js *.jsx *.rs *.go *.cs *.rb *.php *.swift *.c *.h *.cpp *.hpp *.m *.mm *.scala *.dart *.lua *.sh"
    fi
    for p in $found; do printf '%s\n' "$p"; done
}

# Paths that are tests, build output or third-party code.
# 0.1.0 missed androidTest/, Tests/, *Tests.*, *Spec.* — a caller living only in
# an Android instrumentation test counted as production use.
is_noise() {
    _broken noise && return 1
    case "$1" in
        */test/*|*/tests/*|*/Test/*|*/Tests/*|*/testing/*|\
        */androidTest/*|*/androidUnitTest/*|*/commonTest/*|*/integrationTest/*|\
        */jvmTest/*|*/iosTest/*|*/jsTest/*|*/nativeTest/*|*/desktopTest/*|\
        */spec/*|*/specs/*|*/__tests__/*|*/testdata/*|*/fixtures/*|*/e2e/*|\
        */benchmarks/*|*/examples/*|\
        *Test.*|*Tests.*|*_test.*|*_tests.*|*.test.*|*.spec.*|*Spec.*|\
        */test_*.py|*/conftest.py|\
        */build/*|*/dist/*|*/out/*|*/target/*|*/obj/*|\
        */bin/Debug/*|*/bin/Release/*|\
        */node_modules/*|*/vendor/*|*/third_party/*|*/.git/*|*/.gradle/*|\
        */__pycache__/*|*/.venv/*|*/venv/*|*/.tox/*|*/coverage/*|\
        */"$CONFIG_DIR"/*) return 0 ;;
        # `*IT.*` used to live above and swallowed AUDIT, COMMIT, EXIT, SPLIT.
        # Integration-test suffix only counts when preceded by a lowercase letter,
        # so PaymentIT.java is noise and AUDIT.java is not.
        *[a-z]IT.*) return 0 ;;
        *) return 1 ;;
    esac
}

# One pass over the tree, cached for the life of the process.
list_sources() {
    [ -f "$TMP/files" ] && { cat "$TMP/files"; return; }
    : > "$TMP/files"
    source_patterns | while IFS= read -r pat; do
        [ -n "$pat" ] || continue
        find . -type f -name "$pat" 2>/dev/null || true
    done | sort -u | while IFS= read -r f; do
        is_noise "$f" || printf '%s\n' "$f"
    done > "$TMP/files"
    cat "$TMP/files"
}

# A report produced from a subdirectory used to be indistinguishable from a
# report over the whole project: same wording, smaller tree, and "один файл" for
# a symbol whose only caller lives one level up. The scanned root is now stated
# in every report, and a project marker above the current directory is called out.
scanned_root_note() {
    here=$(pwd)
    printf 'Просканировано от: %s\n' "$here"
    root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    if [ -n "$root" ]; then
        case "$here" in
            "$root") ;;
            *) printf 'ВНИМАНИЕ: корень репозитория выше — %s. Здесь виден только его кусок.\n' "$root" ;;
        esac
    fi
}

file_list_or_die() {
    list_sources > "$TMP/list"
    if [ ! -s "$TMP/list" ]; then
        printf 'redfirst: под маски не попал ни один файл.\n'
        printf 'Определённые маски:\n'
        source_patterns | sed 's/^/  /'
        printf 'Задайте свои в %s, по одной на строку.\n' "$SOURCES"
        exit 2
    fi
}

# Match with line numbers across the file list.
grep_sources() {
    re="$1"
    xargs_ok=1
    while IFS= read -r f; do
        grep -En -- "$re" "$f" 2>/dev/null | sed "s|^|$f:|" || true
    done < "$TMP/list"
    [ "$xargs_ok" = 1 ]
}

# ── classification of a match ────────────────────────────────────────────────
# A hit is not a use. 0.1.0 counted doc comments, unused imports and string
# literals, so a completely dead package looked alive.
#
# What is NOT here any more: recognising the declaration of a symbol by its
# syntax. Four rounds of patching that heuristic produced a regex covering
# `fun Foo` and failing on six other forms — a Java method with a return type,
# a Java field with a type, a shell function, the NAME of a Go method, a TS
# class member, a C function. All six reported a dead symbol as alive, and the
# single line printed under "Вызывается:" was its own declaration.
#
# The question changed instead of the parser: not "how many calls" but "in how
# many files outside tests does this name appear in code". A declaration is
# then just one file — no syntax needs recognising, and three honest outcomes
# replace a number that was never trustworthy.
import_re='^[[:space:]]*(import|from|use|using|require|include|#include|package|extern[[:space:]]+crate)([[:space:]]|\()'

# ── wired ────────────────────────────────────────────────────────────────────

cmd_wired() {
    [ $# -ge 1 ] || die 'usage: redfirst wired <Symbol>'
    symbol="$1"
    [ -n "$symbol" ] || die 'пустое имя символа'
    [ "${#symbol}" -le "$MAX_SYMBOL" ] || die "имя длиннее $MAX_SYMBOL символов"
    file_list_or_die

    esc=$(esc_ere "$symbol")
    re=$(bound "$esc")
    grep_sources "$re" > "$TMP/hits" 2>/dev/null || true
    total=$(grep -c . < "$TMP/hits" || true)

    if [ "$total" = "0" ]; then
        printf 'redfirst wired "%s": символ не встречается вообще (0 совпадений).\n' "$symbol"
        printf 'Опечатка в имени или он вне просканированных масок — это НЕ вывод о мёртвом коде.\n'
        exit 2
    fi

    cut -d: -f1 "$TMP/hits" | sort -u > "$TMP/hitfiles"

    # The file list reaches awk as QUOTED positional parameters. It used to be
    # an unquoted `$(cat …)`: a path with a space split into two names that do
    # not exist, awk read nothing at all, and the report printed "всего
    # совпадений 4" with zero in every bucket, followed by a categorical
    # verdict — arithmetic that does not add up, delivered with confidence.
    set --
    while IFS= read -r f; do set -- "$@" "$f"; done < "$TMP/hitfiles"

    # Break point. RF_NOSTRIP makes the classifier read raw lines, so a symbol
    # named only in a comment counts as real use — the 0.1.0 failure this awk
    # block exists to prevent, and the only thing the suite can check it by.
    _rf_nostrip=0
    _broken strings && _rf_nostrip=1
    # Quote characters travel through the environment so this program can be
    # written inside single quotes without escaping gymnastics. Regexes travel
    # the same way: awk -v processes escape sequences and would eat the
    # backslash that makes `auth.login` a literal dot.
    RF_SYM="$re" RF_IMP="$import_re" RF_NOSTRIP="$_rf_nostrip" \
    RF_DQ='"' RF_SQ=$(printf '\47') RF_BT='`' \
    awk '
    BEGIN {
        dq = ENVIRON["RF_DQ"]; sq = ENVIRON["RF_SQ"]; bt = ENVIRON["RF_BT"]
        dq3 = dq dq dq; sq3 = sq sq sq
    }
    function isshell(f) { return (f ~ /\.(sh|bash|zsh|ksh)$/) }
    function marker(f) {
        if (f ~ /\.(py|rb|sh|bash|zsh|ksh|pl|pm|r|yaml|yml|toml|conf|cfg)$/) return "#"
        if (f ~ /\.(sql|lua|hs|elm|adb|ads)$/) return "--"
        return "//"
    }
    # One left-to-right pass over the line, carrying state between lines.
    # Strings and comments are recognised in the same scan, because doing them
    # in two passes gets both wrong: a // inside a string is not a comment, and
    # an apostrophe inside a comment is not a string.
    function strip(s,   out, n, i, c, c3, j, d, cj, p) {
        out = ""; n = length(s); i = 1
        while (i <= n) {
            if (st == "blk") {
                p = index(substr(s, i), "*/")
                if (p == 0) return out
                i = i + p + 1; st = ""
                continue
            }
            c = substr(s, i, 1)
            if (st == "str") {
                # An interpolated expression inside a string IS code.
                # "key=${store.fingerprint()}" is a real call, and blanking it
                # is how a live symbol was reported dead on real Kotlin: both
                # of its call sites sat inside string templates.
                if (c == "$" && substr(s, i + 1, 1) == "{") {
                    d = 0; j = i + 1
                    while (j <= n) {
                        cj = substr(s, j, 1)
                        if (cj == "{") d++
                        else if (cj == "}") { d--; if (d == 0) break }
                        j++
                    }
                    out = out " " substr(s, i + 2, j - i - 2) " "
                    i = j + 1
                    continue
                }
                if (c == "\\") { i += 2; continue }
                if (q == dq3 || q == sq3) {
                    if (substr(s, i, 3) == q) { st = ""; q = ""; i += 3; continue }
                } else if (c == q) { st = ""; q = ""; i++; continue }
                i++
                continue
            }
            c3 = substr(s, i, 3)
            if (c3 == dq3 || c3 == sq3) { st = "str"; q = c3; i += 3; continue }
            if (c == dq || c == sq || c == bt) { st = "str"; q = c; i++; continue }
            if (m == "//" && substr(s, i, 2) == "/*") { st = "blk"; i += 2; continue }
            if (substr(s, i, length(m)) == m) return out
            out = out c; i++
        }
        return out
    }
    FNR == 1 { st = ""; q = ""; hw = ""; m = marker(FILENAME); shf = isshell(FILENAME) }
    {
        raw = $0
        if (ENVIRON["RF_NOSTRIP"] == "1") code = raw
        else if (st == "here") {
            t = raw; sub(/^[ \t]+/, "", t); sub(/[ \t]+$/, "", t)
            if (t == hw) { st = ""; hw = "" }
            code = ""
        } else {
            code = strip(raw)
            # Only a triple quote or a backtick spans lines. A single quote or
            # double quote left open at end of line is an apostrophe in prose,
            # not a string: carrying it over blanked the rest of the file.
            if (st == "str" && q != dq3 && q != sq3 && q != bt) { st = ""; q = "" }
            # Shell heredoc. Restricted to shell files because << is a shift
            # operator everywhere else.
            if (shf && st == "") {
                p = index(raw, "<<")
                if (p > 0) {
                    w = substr(raw, p + 2)
                    sub(/^-/, "", w)
                    sub(/^[ \t]+/, "", w)
                    c = substr(w, 1, 1)
                    if (c == dq || c == sq) w = substr(w, 2)
                    if (match(w, /^[A-Za-z_][A-Za-z0-9_]*/)) {
                        hw = substr(w, 1, RLENGTH); st = "here"
                    }
                }
            }
        }
        if (code ~ ENVIRON["RF_SYM"]) {
            if (code ~ ENVIRON["RF_IMP"]) bucket = "imp"
            else                          bucket = "code"
        } else if (raw ~ ENVIRON["RF_SYM"]) {
            bucket = "text"
        } else next
        printf "%s\t%s\t%s:%d:%s\n", bucket, FILENAME, FILENAME, FNR, raw
    }
    ' "$@" > "$TMP/cls" 2>/dev/null || : > "$TMP/cls"

    # The unit is the FILE, not the hit. A declaration needs no recognising:
    # it is simply the one file the name occurs in.
    grep "^code	" "$TMP/cls" 2>/dev/null | cut -f2 | sort -u > "$TMP/codefiles"
    cut -f2 "$TMP/cls" 2>/dev/null | sort -u > "$TMP/allfiles"
    comm -23 "$TMP/allfiles" "$TMP/codefiles" > "$TMP/textfiles"
    nall=$(grep -c . < "$TMP/allfiles" || true)
    ncode=$(grep -c . < "$TMP/codefiles" || true)
    ntext=$(grep -c . < "$TMP/textfiles" || true)
    nhits=$(grep -c "^code	" "$TMP/cls" || true)
    # Break point: shifts the one-file threshold, so every "мёртв" verdict must
    # turn into "жив" and the suite must notice.
    _broken single && ncode=$((ncode + 1))

    printf 'redfirst wired "%s"\n' "$symbol"
    scanned_root_note
    printf '  файлов с упоминанием  %s\n' "$nall"
    printf '  из них в коде         %s\n' "$ncode"
    printf '  только вне кода       %s\n' "$ntext"
    printf '  упоминаний в коде     %s\n' "$nhits"

    if [ "$ncode" = "0" ]; then
        printf 'В КОДЕ ИМЯ НЕ ВСТРЕЧАЕТСЯ НИГДЕ — только в строках, комментариях и импортах:\n'
        grep -v "^code	" "$TMP/cls" | cut -f3 | head -n 5 | sed 's/^/  /'
        printf 'Упоминание — не использование. Вещи нет в работающей системе.\n'
        exit 1
    fi
    if [ "$ncode" = "1" ]; then
        # One file, one mention: nothing names this, including itself. One file,
        # several mentions: it is used, but only by its own file. The two need
        # different words — a private helper is normal, a service nobody outside
        # calls is not — and the difference is countable without parsing syntax.
        if [ "$nhits" = "1" ]; then
            printf 'ЕДИНСТВЕННОЕ УПОМИНАНИЕ во всём проекте:\n'
            grep "^code	" "$TMP/cls" | cut -f3 | sed 's/^/  /'
            printf 'Если это объявление — вещь мертва: её не называет никто, включая её саму.\n'
            printf 'Если это вызов — объявление лежит вне просканированных масок.\n'
        else
            printf 'ТОЛЬКО ВНУТРИ СВОЕГО ФАЙЛА: %s упоминаний, все в одном файле.\n' "$nhits"
            grep "^code	" "$TMP/cls" | cut -f3 | head -n 8 | sed 's/^/  /'
            printf 'За пределами этого файла имени нет. Для частного помощника это норма,\n'
            printf 'для класса или сервиса — повод спросить, кто должен был его звать.\n'
        fi
        if [ "$ntext" != "0" ]; then
            printf 'Ещё упомянуто вне кода (в счёт не идёт):\n'
            grep -v "^code	" "$TMP/cls" | cut -f3 | head -n 3 | sed 's/^/  /'
        fi
        exit 1
    fi
    printf 'ЖИВЁТ: имя встречается в коде %s файлов.\n' "$ncode"
    grep "^code	" "$TMP/cls" | cut -f3 | head -n 8 | sed 's/^/  /'
    [ "$nhits" -gt 8 ] && printf '  … и ещё %s упоминаний\n' "$((nhits - 8))"
    exit 0
}

# ── samples ──────────────────────────────────────────────────────────────────

cmd_samples() {
    [ $# -ge 1 ] || die 'usage: redfirst samples <pattern>'
    pattern="$1"
    file_list_or_die
    # Validity is decided by grep's exit code, not by matching the wording of its
    # error message. 0.2.0 pattern-matched the text, missed it on this grep, and
    # reported a broken expression as "0 совпадений" with a clean exit —
    # a failed check presented as a passed one.
    set +e
    printf '' | grep -E -- "$pattern" >/dev/null 2>&1
    rc=$?
    set -e
    [ "$rc" -gt 1 ] && die "неверное регулярное выражение: $pattern"
    grep_sources "$pattern" > "$TMP/hits" 2>/dev/null || true
    count=$(grep -c . < "$TMP/hits" || true)
    printf 'redfirst samples "%s": %s совпадений\n' "$pattern" "$count"
    [ "$count" = "0" ] && exit 1
    # First / middle / last, not the first three: the miscount this exists for
    # hid in the tail, and three consecutive lines from the top confirmed it.
    printf 'Образцы из начала, середины и конца — сверьте, что посчитано именно то:\n'
    if [ "$count" -le 3 ]; then
        sed 's/^/  /' "$TMP/hits"
    else
        mid=$(( (count + 1) / 2 ))
        sed -n "1p;${mid}p;${count}p" "$TMP/hits" | sed 's/^/  /'
    fi
    exit 0
}

# ── counter ──────────────────────────────────────────────────────────────────
# Absence claims scan EVERYTHING, including tests and vendor: a secret hiding in
# a fixture is still a secret, and 0.1.0 confirmed its absence.

cmd_counter() {
    [ $# -ge 1 ] || die 'usage: redfirst counter <term> [term...]'
    printf 'redfirst counter: ищу то, чего якобы нет (включая тесты и vendor).\n'
    scanned_root_note
    any=0
    for term in "$@"; do
        [ -n "$term" ] || continue
        esc=$(esc_ere "$term")
        # Status is captured directly. Inside `if ! out=$(...)`, $? is the status
        # of the negation — always 0 — so the whole "ОШИБКА ПОИСКА" branch below
        # was unreachable and a failed search silently confirmed absence.
        # Verified: `if ! out=$(sh -c "exit 2"); then echo $?; fi` prints 0.
        # -I is gone on purpose: a secret inside a binary fixture is still a secret.
        set +e
        out=$(grep -RnE -- "$esc" . 2>"$TMP/gerr")
        status=$?
        set -e
        if [ "$status" -gt 1 ]; then
            printf '  %-28s ОШИБКА ПОИСКА — отсутствие НЕ подтверждено\n' "$term"
            [ -s "$TMP/gerr" ] && head -n 2 "$TMP/gerr" | sed 's/^/      /'
            any=2; continue
        fi
        if [ -s "$TMP/gerr" ]; then
            printf '  %-28s часть путей не прочитана — отсутствие НЕ подтверждено\n' "$term"
            head -n 2 "$TMP/gerr" | sed 's/^/      /'
            any=2; continue
        fi
        c=$(printf '%s' "$out" | grep -c . || true)
        printf '  %-28s %s\n' "$term" "$c"
        if [ "$c" != "0" ]; then
            any=1
            printf '%s\n' "$out" | head -n 2 | sed 's/^/      /'
        fi
    done
    if [ "$any" = "2" ]; then
        printf 'Поиск завершился ошибкой. Утверждать отсутствие нельзя.\n'; exit 2
    fi
    if [ "$any" = "1" ]; then
        printf 'Найдено. Утверждение об отсутствии в этой формулировке неверно.\n'; exit 1
    fi
    printf 'Не найдено. Приложите этот вывод к утверждению об отсутствии.\n'
    exit 0
}

# ── due ──────────────────────────────────────────────────────────────────────
# Any field this cannot parse counts as OVERDUE. 0.1.0 treated an unreadable
# date, a non-numeric period and a stray separator as "fine" and printed green.

# Date handling is pure arithmetic — no `date` fork per asset and no dependence
# on whether this machine has GNU or BSD date. `due` runs at every session start;
# 0.2.x spent nine forks per line and took tens of seconds on a long registry,
# which is a cost people respond to by deleting the hook.
# Sets _days to days since 1970-01-01, or returns 1 for anything unparseable.
# Strips leading zeros without a fork and without the non-POSIX base# prefix.
_d=0
dec() {
    _d=$1
    while :; do case $_d in 0?*) _d=${_d#0} ;; *) break ;; esac; done
    [ -n "$_d" ] || _d=0
}

_days=0
parse_date() {
    if _broken dates; then _days=0; return 0; fi
    case "$1" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
        *) return 1 ;;
    esac
    y=${1%%-*}; rest=${1#*-}; mo=${rest%%-*}; d=${rest#*-}
    # NOT $((10#$mo)): the base# prefix is a bash/ksh extension. On Debian and
    # Raspberry Pi OS /bin/sh is dash, where $((10#08)) is a syntax error — so
    # every date in August or September crashed the whole command. Verified on
    # the target platform, not assumed.
    dec "$y";  y=$_d
    dec "$mo"; mo=$_d
    dec "$d";  d=$_d
    [ "$mo" -ge 1 ] && [ "$mo" -le 12 ] || return 1
    case $mo in
        1|3|5|7|8|10|12) dim=31 ;;
        4|6|9|11) dim=30 ;;
        *) if [ $(( (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 )) -eq 1 ]
           then dim=29; else dim=28; fi ;;
    esac
    [ "$d" -ge 1 ] && [ "$d" -le "$dim" ] || return 1   # rejects 2026-02-30
    # days_from_civil, restricted to y >= 0 which holds for every real date here
    yy=$y
    [ "$mo" -le 2 ] && yy=$((y - 1))
    if [ "$mo" -gt 2 ]; then mm=$((mo - 3)); else mm=$((mo + 9)); fi
    era=$((yy / 400)); yoe=$((yy - era * 400))
    doy=$(( (153 * mm + 2) / 5 + d - 1 ))
    doe=$(( yoe * 365 + yoe / 4 - yoe / 100 + doy ))
    _days=$(( era * 146097 + doe - 719468 ))
    return 0
}

# Parameter-expansion replacements for trim and cut: same result, no fork.
_f1=""; _f2=""; _f3=""
split3() {
    l=$1
    _f1=${l%%|*}
    if [ "$l" = "$_f1" ]; then _f2=""; _f3=""; else
        r=${l#*|}; _f2=${r%%|*}
        if [ "$r" = "$_f2" ]; then _f3=""; else r2=${r#*|}; _f3=${r2%%|*}; fi
    fi
    for v in 1 2 3; do
        eval "t=\$_f$v"
        while :; do case $t in [[:space:]]*) t=${t#?} ;; *) break ;; esac; done
        while :; do case $t in *[[:space:]]) t=${t%?} ;; *) break ;; esac; done
        eval "_f$v=\$t"
    done
}

cmd_due() {
    quiet=0
    [ "${1:-}" = "--quiet" ] && quiet=1
    # --quiet silences the success line and nothing else. It used to swallow
    # every failure mode too, so a missing or unreadable registry made the
    # session-start hook print nothing at all — indistinguishable from "clean".
    if [ ! -e "$ASSETS" ]; then
        die "нет $ASSETS. Запустите: redfirst init"
    fi
    [ -f "$ASSETS" ] || die "$ASSETS не обычный файл"
    [ -r "$ASSETS" ] || die "$ASSETS не читается"
    # Today, and the whole file's line endings, normalised once instead of per
    # line. A lone CR is turned into a newline too: a registry saved with classic
    # Mac endings used to arrive as one giant line and every asset vanished.
    today=$(date +%Y-%m-%d)
    parse_date "$today" || die "не удалось разобрать сегодняшнюю дату ($today)"
    now_days=$_days
    tr '\r' '\n' < "$ASSETS" > "$TMP/assets.norm"
    bad=0; total=0; out="$TMP/out"; : > "$out"

    first=1
    # `|| [ -n "$raw" ]` keeps the final line when the file has no trailing
    # newline — 0.1.0 dropped it and reported all-clear.
    while IFS= read -r raw || [ -n "$raw" ]; do
        line=$raw
        if [ "$first" = 1 ]; then line=${line#"$BOM"}; first=0; fi
        case $line in
            '') continue ;;
        esac
        # Leading whitespace is stripped BEFORE the comment test. The glob
        # `[[:space:]]*\#*` reads as "one space, anything, a hash, anything",
        # so " Ключ подписи #1 | never | 90" was silently dropped as a comment
        # — an indented asset with a hash in its name vanished from the count.
        stripped=$line
        while :; do case $stripped in [[:space:]]*) stripped=${stripped#?} ;; *) break ;; esac; done
        case $stripped in
            ''|\#*) continue ;;
        esac
        case $line in *[![:space:]]*) ;; *) continue ;; esac
        total=$((total + 1))

        split3 "$line"
        name=$_f1; verified=$_f2; period=$_f3

        if [ -z "$name" ]; then
            printf '  ! строка без имени: "%s" — не разобрана\n' "$line" >> "$out"; bad=$((bad+1)); continue
        fi
        case "$period" in
            ''|*[!0-9]*) printf '  ! %s — период "%s" не число, проверка не действует\n' "$name" "$period" >> "$out"; bad=$((bad+1)); continue ;;
        esac
        dec "$period"; [ "$_d" -gt 0 ] 2>/dev/null || { printf '  ! %s — период должен быть больше нуля\n' "$name" >> "$out"; bad=$((bad+1)); continue; }
        period=$_d

        case $verified in
            [Nn][Ee][Vv][Ee][Rr]|'')
                printf '  ! %s — восстановление НИ РАЗУ не проверялось\n' "$name" >> "$out"; bad=$((bad+1)); continue ;;
        esac
        if ! parse_date "$verified"; then
            printf '  ! %s — дата "%s" не разобрана (нужен формат ГГГГ-ММ-ДД)\n' "$name" "$verified" >> "$out"; bad=$((bad+1)); continue
        fi
        vep=$_days
        if [ "$vep" -gt "$now_days" ]; then
            printf '  ! %s — дата "%s" в будущем, вероятно опечатка\n' "$name" "$verified" >> "$out"; bad=$((bad+1)); continue
        fi
        age=$(( now_days - vep ))
        if [ "$age" -gt "$period" ]; then
            printf '  ! %s — проверено %s дн. назад, норма %s\n' "$name" "$age" "$period" >> "$out"; bad=$((bad+1))
        fi
    done < "$TMP/assets.norm"

    # Where this prints decides whether the tool works at all. A SessionStart
    # hook shows stdout only when it exits 0, and stderr only when it does not.
    # 0.4.x printed to stdout and exited 1 — the single automatic guarantee of
    # the product reached nobody, ever. In hook mode everything goes to stderr
    # with a non-zero exit, which is the combination the harness surfaces.
    say() {
        if _broken quiet; then printf '%s\n' "$1"; return; fi
        if [ "$quiet" = 1 ]; then printf '%s\n' "$1" >&2; else printf '%s\n' "$1"; fi
    }

    if [ "$total" = "0" ]; then
        # An empty registry is the state right after installation, and silence
        # here is indistinguishable from "everything checked".
        say 'redfirst: список невосстановимых активов пуст — впишите свои в .redfirst/irreplaceable.'
        exit 1
    fi
    if [ "$bad" -gt 0 ]; then
        if _broken quiet; then cat "$out"
        elif [ "$quiet" = 1 ]; then cat "$out" >&2
        else cat "$out"; fi
        say "redfirst: $bad из $total невосстановимых активов требует внимания."
        say 'Копия, из которой ни разу не восстанавливали, — не копия.'
        say 'Отметить после проверки: redfirst verified "<имя>"'
        exit 1
    fi
    [ "$quiet" = 1 ] || printf 'redfirst: все %s активов проверены в срок.\n' "$total"
    exit 0
}

# ── verified ─────────────────────────────────────────────────────────────────

cmd_verified() {
    [ $# -ge 1 ] || die 'usage: redfirst verified "<имя>"'
    name=$(trim "$1")
    [ -n "$name" ] || die 'пустое имя'
    [ -f "$ASSETS" ] || die "нет $ASSETS"
    today=$(date +%Y-%m-%d)
    # Lock, and write the replacement NEXT TO the registry rather than in $TMP:
    # mv is atomic only within one filesystem, and $TMP is often another device,
    # so the previous cp left a window where the file was half-written. Two
    # concurrent runs used to lose records and append a phantom asset.
    lock="$CONFIG_DIR/.lock"
    mkdir "$lock" 2>/dev/null || die "другой redfirst уже правит реестр (снимите $lock, если это не так)"
    trap 'rmdir "$lock" 2>/dev/null || true; rm -f "$ASSETS".new.* 2>/dev/null || true; cleanup' EXIT INT TERM
    # Normalise here, in THIS process. 0.4.0 pointed this loop at a file that
    # only `due` creates, in `due`'s own temp directory, so `verified` failed on
    # every invocation, in every shell, while `due` kept advertising it in each
    # report. Caused by a global sed that matched both read loops at once.
    tr '\r' '\n' < "$ASSETS" > "$TMP/verify.norm"
    tmp="$ASSETS.new.$$"
    : > "$tmp"
    found=0
    while IFS= read -r raw || [ -n "$raw" ]; do
        line=$(clean_line "$raw")
        cur=$(trim "$(printf '%s' "$line" | cut -d'|' -f1)")
        if [ "$found" = 0 ] && [ -n "$name" ] && [ "$cur" = "$name" ]; then
            period=$(trim "$(printf '%s' "$line" | cut -d'|' -f3)")
            # Refuse rather than substitute a default. Silently writing 30 over an
            # unparseable period erased the only evidence that the line was broken
            # and turned a red `due` into a green one.
            case "$period" in
                ''|*[!0-9]*) die "период \"$period\" у актива \"$name\" не разобран — почините строку вручную" ;;
            esac
            rest=$(printf '%s' "$line" | cut -s -d'|' -f4-)
            if [ -n "$rest" ]; then
                printf '%s | %s | %s |%s\n' "$name" "$today" "$period" "$rest" >> "$tmp"
            else
                printf '%s | %s | %s\n' "$name" "$today" "$period" >> "$tmp"
            fi
            found=1
        else
            printf '%s\n' "$line" >> "$tmp"
        fi
    done < "$TMP/verify.norm"
    [ "$found" = 1 ] || { rm -f "$tmp"; die "актива с именем \"$name\" в $ASSETS нет"; }
    mv -f "$tmp" "$ASSETS"
    printf 'redfirst: "%s" отмечен проверенным %s.\n' "$name" "$today"
}

# ── init ─────────────────────────────────────────────────────────────────────

cmd_init() {
    mkdir -p "$CONFIG_DIR"
    printf 'redfirst %s\n\n' "$VERSION"
    printf 'Маски исходников (проверьте, что это ваш проект):\n'
    source_patterns | tr '\n' ' ' | sed 's/^/  /;s/$/\n/'
    n=$(list_sources | grep -c . || true)
    printf 'Под них попало файлов: %s\n' "$n"
    [ "$n" = "0" ] && printf 'Ноль — задайте свои маски в %s, иначе проверки бесполезны.\n' "$SOURCES"
    printf '\n'
    if [ -f "$ASSETS" ]; then
        printf '%s уже существует — оставляю как есть.\n' "$ASSETS"
    else
        tpl="$(dirname "$0")/../templates/irreplaceable"
        if [ -f "$tpl" ]; then cp "$tpl" "$ASSETS"
        else printf '# имя | дата последней проверки ВОССТАНОВЛЕНИЯ | период, дней\n' > "$ASSETS"; fi
        printf 'Создан %s.\n\n' "$ASSETS"
        printf 'Впишите туда, что незаменимо. Не сканирую ваши ~/.ssh и ~/.android\n'
        printf 'намеренно: печатать на экран список путей к приватным ключам —\n'
        printf 'ровно та ошибка, которую этот инструмент должен предотвращать.\n'
        printf 'Незаменим не редкий файл, а тот, чья потеря останавливает продукт,\n'
        printf 'включая то, что лежит на сервере.\n'
    fi
}

usage() {
    cat <<'EOF'
redfirst — детерминированные точки останова для разработки с ИИ.

  redfirst init                 определить проект, создать конфиг
  redfirst due [--quiet]        просроченные проверки восстановления
  redfirst verified "<имя>"     отметить актив проверенным сегодня
  redfirst wired <Symbol>       в скольких файлах имя есть в коде; один — мёртвый
  redfirst samples <pattern>    число + образцы начала, середины и конца
  redfirst counter <term...>    поиск того, чего якобы нет

Коды: 0 — чисто, 1 — есть на что смотреть, 2 — проверить не удалось.
Код 2 никогда не означает «всё в порядке».
EOF
}

# Sourced as a library by the unit tests, which need parse_date, split3 and
# is_noise directly; a dispatcher that fires on source makes that impossible.
[ "${REDFIRST_LIB:-}" = "1" ] && return 0 2>/dev/null

[ $# -ge 1 ] || { usage; exit 0; }
cmd="$1"; shift
case "$cmd" in
    init)     cmd_init "$@" ;;
    due)      cmd_due "$@" ;;
    verified) cmd_verified "$@" ;;
    wired)    cmd_wired "$@" ;;
    samples)  cmd_samples "$@" ;;
    counter)  cmd_counter "$@" ;;
    -h|--help|help) usage ;;
    -v|--version)   printf 'redfirst %s\n' "$VERSION" ;;
    *) die "неизвестная команда: $cmd" ;;
esac
