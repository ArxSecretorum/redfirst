#!/bin/sh
# redfirst — deterministic checkpoints for AI-assisted development.
#
# Every subcommand ends in an artifact a non-reader can judge: a count with its
# breakdown, samples of what was counted, or an overdue date. Nothing here
# reports "I checked, it's fine".
#
# Design rule earned the hard way: when this tool is unsure, it must fail LOUD
# (report a problem) and never fail SILENT (report all-clear). Version 0.1.0
# failed silent in twenty places — an unparseable date, an unknown project
# layout and a symbol containing a dot all produced a confident green.
#
# No dependencies beyond POSIX sh, grep, find, sed. No network. No self-update.
set -eu
# Character classes below are locale-sensitive: without a UTF-8 locale
# [[:alnum:]] degrades to ASCII and a Cyrillic symbol matches inside a longer
# identifier. Verified failure, not a precaution.
LC_ALL="${LC_ALL:-C.UTF-8}"; export LC_ALL

set -f          # globbing off: an unquoted mask like *.kt would otherwise be
                # expanded by the shell against the current directory before
                # find ever sees it, silently limiting every scan to the root.

VERSION="0.5.0"
CONFIG_DIR="${REDFIRST_DIR:-.redfirst}"
ASSETS="$CONFIG_DIR/irreplaceable"
SOURCES="$CONFIG_DIR/sources"
MAX_SYMBOL=200          # guards the quadratic blowup on absurd input
TMP=""

cleanup() { [ -n "$TMP" ] && rm -rf "$TMP" 2>/dev/null; return 0; }
trap cleanup EXIT INT TERM
# PIPE and HUP are not in that list by default, and PIPE is not exotic: it
# arrives every time the output is cut short — `redfirst counter … | head -1`,
# `… | grep -q`. Without a trap the shell dies on the spot and the temporary
# directory stays behind. Found by looking at the target machine: eight empty
# /tmp/redfirst.* directories, two per nightly run. Under Git Bash it does not
# happen at all, so nothing here could have shown it.
#
# The exit codes are the conventional 128 + signal, so a caller still sees that
# the run was killed rather than finished.
trap 'cleanup; exit 141' PIPE
trap 'cleanup; exit 129' HUP
# Sourced as a library, this file runs no subcommand and needs no scratch space
# — see the REDFIRST_LIB guard at the bottom. Creating the directory anyway put
# its removal at the mercy of the sourcing script: a unit test that sets its own
# EXIT trap after `. redfirst` replaces the cleanup, and the directory stays.
# That is precisely what happened, and it littered the target machine with two
# directories per suite run. Not creating what is not needed removes the whole
# class instead of the instance.
if [ "${REDFIRST_LIB:-}" = "1" ]; then
    TMP=""
else
    TMP=$(mktemp -d "${TMPDIR:-/tmp}/redfirst.XXXXXX") || {
        printf 'redfirst: could not create a temporary directory
' >&2; exit 2; }
fi

# Deliberate defects, for the regression suite's self-check. A suite that
# cannot be shown to go red proves nothing - the same "green proves nothing"
# this tool exists to fight, one level up. Guarded twice so it cannot fire
# in production.
_broken() {
    [ "${REDFIRST_SELFTEST:-}" = "1" ] || return 1
    [ "${REDFIRST_BREAK:-}" = "$1" ]
}

die()  { printf '%s\n' "redfirst: $*" >&2; exit 2; }
warn() { printf '%s\n' "redfirst: $*" >&2; }

# Strip UTF-8 BOM and CR. Config files get edited in Windows editors; a trailing
# \r turned "30" into "30\r" and disabled the check for that asset entirely.
# The BOM is removed by parameter expansion rather than sed: octal escapes are
# not portable across sed implementations and GNU sed read \357 as a back
# reference, which broke every line instead of cleaning it.
BOM=$(printf '\357\273\277')
clean_line() {
    l=${1#"$BOM"}
    printf '%s' "$l" | tr -d '\r'
}

trim() { printf '%s' "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }

# Escape every ERE metacharacter so a symbol is matched literally.
# `auth.login` used to match `auth_login`.
esc_ere() { printf '%s' "$1" | sed 's/[][\\.*^$(){}?+|]/\\&/g'; }

# Word boundary defined explicitly rather than via grep -w, which treats
# non-ASCII bytes as non-word characters and so matched Cyrillic identifiers
# inside longer ones.
bound() { printf '(^|[^[:alnum:]_])%s([^[:alnum:]_]|$)' "$1"; }

# ── source discovery ─────────────────────────────────────────────────────────

source_patterns() {
    if [ -f "$SOURCES" ]; then
        pats=$(grep -v '^[[:space:]]*#' "$SOURCES" 2>/dev/null | grep -v '^[[:space:]]*$' || true)
        [ -n "$pats" ] && { printf '%s\n' "$pats"; return; }
        warn "$SOURCES is empty or all comments - falling back to auto-detection"
    fi
    found=""
    # XML included on purpose: in Android half of the wiring lives there, not in
    # the code. Measured on a real project — of nine symbols reported as having a
    # single mention, five were an Application, a Service and Receivers wired
    # through the manifest. Without this the tool calls them dead, confidently,
    # on the kind of project it was written for.
    [ -f build.gradle.kts ] || [ -f build.gradle ] || [ -f settings.gradle.kts ] && found="*.kt *.java *.kts *.xml"
    [ -f pyproject.toml ] || [ -f setup.py ] || [ -f requirements.txt ] && found="$found *.py"
    [ -f package.json ] && found="$found *.ts *.tsx *.js *.jsx *.mjs *.cjs *.svelte *.vue"
    [ -f Cargo.toml ] && found="$found *.rs"
    [ -f go.mod ] && found="$found *.go"
    [ -f pom.xml ] || [ -f build.xml ] && found="$found *.java"
    find . -maxdepth 1 \( -name '*.csproj' -o -name '*.sln' \) 2>/dev/null | grep -q . && found="$found *.cs"
    [ -f Gemfile ] && found="$found *.rb"
    [ -f composer.json ] && found="$found *.php"
    if [ -z "$(trim "$found")" ]; then
        # No marker: scan every extension we know rather than '*', which used to
        # drag in binaries and lock files and slow everything to a crawl.
        found="*.kt *.java *.py *.ts *.tsx *.js *.jsx *.rs *.go *.cs *.rb *.php *.swift *.c *.h *.cpp *.hpp *.m *.mm *.scala *.dart *.lua *.sh"
    fi
    for p in $found; do printf '%s\n' "$p"; done
}

# Paths that are tests, build output or third-party code.
# 0.1.0 missed androidTest/, Tests/, *Tests.*, *Spec.* — a caller living only in
# an Android instrumentation test counted as production use.
is_noise() {
    _broken noise && return 1
    case "$1" in
        */test/*|*/tests/*|*/Test/*|*/Tests/*|*/testing/*|\
        */androidTest/*|*/androidUnitTest/*|*/commonTest/*|*/integrationTest/*|\
        */jvmTest/*|*/iosTest/*|*/jsTest/*|*/nativeTest/*|*/desktopTest/*|\
        */spec/*|*/specs/*|*/__tests__/*|*/testdata/*|*/fixtures/*|*/e2e/*|\
        */benchmarks/*|*/examples/*|\
        *Test.*|*Tests.*|*_test.*|*_tests.*|*.test.*|*.spec.*|*Spec.*|\
        */test_*.py|*/conftest.py|\
        */build/*|*/dist/*|*/out/*|*/target/*|*/obj/*|\
        */bin/Debug/*|*/bin/Release/*|\
        */node_modules/*|*/vendor/*|*/third_party/*|*/.git/*|*/.gradle/*|\
        */__pycache__/*|*/.venv/*|*/venv/*|*/.tox/*|*/coverage/*|\
        */"$CONFIG_DIR"/*) return 0 ;;
        # `*IT.*` used to live above and swallowed AUDIT, COMMIT, EXIT, SPLIT.
        # Integration-test suffix only counts when preceded by a lowercase letter,
        # so PaymentIT.java is noise and AUDIT.java is not.
        *[a-z]IT.*) return 0 ;;
        *) return 1 ;;
    esac
}

# One pass over the tree, cached for the life of the process.
list_sources() {
    [ -f "$TMP/files" ] && { cat "$TMP/files"; return; }
    : > "$TMP/files"
    # Каталоги сборки отсекаются в самом обходе, а не после него. На настоящем
    # Android-проекте дерево — 19169 файлов, из них 17669 под build/, и каждая
    # маска обходила их заново, чтобы is_noise потом всё это выбросил.
    # Отсекается ровно то, что is_noise и так считает шумом: список вердиктов
    # от этого не меняется, меняется только цена обхода.
    source_patterns | while IFS= read -r pat; do
        [ -n "$pat" ] || continue
        find . -type d \( -name build -o -name .git -o -name .gradle \
                          -o -name node_modules -o -name vendor -o -name third_party \
                          -o -name dist -o -name out -o -name target -o -name obj \
                          -o -name __pycache__ -o -name .venv -o -name venv -o -name .tox \) \
               -prune -o -type f -name "$pat" -print 2>/dev/null || true
    done | sort -u | while IFS= read -r f; do
        is_noise "$f" || printf '%s\n' "$f"
    done > "$TMP/files"
    cat "$TMP/files"
}

# A report produced from a subdirectory used to be indistinguishable from a
# report over the whole project: same wording, smaller tree, and "один файл" for
# a symbol whose only caller lives one level up. The scanned root is now stated
# in every report, and a project marker above the current directory is called out.
scanned_root_note() {
    here=$(pwd)
    printf 'Scanned from: %s\n' "$here"
    root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    if [ -n "$root" ]; then
        # Оба пути прогоняются через одну и ту же оболочку, а не сравниваются
        # как есть. Под Git Bash `pwd` даёт /c/Users/…, а git — C:/Users/…, и
        # дословное сравнение не совпадало НИКОГДА: предупреждение «корень выше»
        # печаталось в самом корне, на каждом запуске. Найдено новой командой
        # `changed` на первом же пробном прогоне.
        root_real=$(cd "$root" 2>/dev/null && pwd -P) || root_real=""
        here_real=$(pwd -P)
        case "$here_real" in
            "$root_real") ;;
            *) printf 'WARNING: the repository root is higher up - %s. Only a slice of it is visible here.\n' "$root" ;;
        esac
    fi
}

file_list_or_die() {
    list_sources > "$TMP/list"
    if [ ! -s "$TMP/list" ]; then
        printf 'redfirst: no file matched the source masks.\n'
        printf 'Masks detected:\n'
        source_patterns | sed 's/^/  /'
        printf 'Set your own in %s, one per line.\n' "$SOURCES"
        exit 2
    fi
}

# Match with line numbers across the file list.
#
# One grep per BATCH of files, not per file. The previous form forked grep and
# sed for every file: on a 227-file Android project that is 454 processes for a
# single `wired`, and 14.8 seconds under Git Bash, of which 11.4 were system
# time. Not work - process creation. Measured on a real sweep that would have
# taken 110 minutes.
#
# `/dev/null` at the end of each batch forces grep to print the file name even
# when a batch holds a single file, which is exactly what the manual `sed`
# prefix used to do. Batching keeps the command line inside every platform's
# limit; positional parameters are function-local in POSIX sh and are restored
# on return, so the caller's `$@` is untouched.
grep_sources() {
    re="$1"
    set --
    _gs=0
    while IFS= read -r f; do
        set -- "$@" "$f"
        _gs=$((_gs + 1))
        if [ "$_gs" -ge 200 ]; then
            grep -En -- "$re" "$@" /dev/null 2>/dev/null || true
            set --; _gs=0
        fi
    done < "$TMP/list"
    if [ "$_gs" -gt 0 ]; then
        grep -En -- "$re" "$@" /dev/null 2>/dev/null || true
    fi
    return 0
}

# ── classification of a match ────────────────────────────────────────────────
# A hit is not a use. 0.1.0 counted doc comments, unused imports and string
# literals, so a completely dead package looked alive.
#
# What is NOT here any more: recognising the declaration of a symbol by its
# syntax. Four rounds of patching that heuristic produced a regex covering
# `fun Foo` and failing on six other forms — a Java method with a return type,
# a Java field with a type, a shell function, the NAME of a Go method, a TS
# class member, a C function. All six reported a dead symbol as alive, and the
# single line printed under "Вызывается:" was its own declaration.
#
# The question changed instead of the parser: not "how many calls" but "in how
# many files outside tests does this name appear in code". A declaration is
# then just one file — no syntax needs recognising, and three honest outcomes
# replace a number that was never trustworthy.
import_re='^[[:space:]]*(import|from|use|using|require|include|#include|package|extern[[:space:]]+crate)([[:space:]]|\()'

# ── the classifier program ───────────────────────────────────────────────────
# Held in a variable instead of inlined at the call site so a unit test can feed
# it lines directly. It is the longest and least obvious code in this file, and
# until it moved here the only way to check it was a full run of the tool: one
# and a half seconds per assertion, and every failure arriving indirectly, as a
# verdict rather than as a bucket.
#
# No apostrophe appears inside the program — quote characters travel in through
# the environment — so it can live in a single-quoted string with no escaping.
CLASSIFIER='
    BEGIN {
        dq = ENVIRON["RF_DQ"]; sq = ENVIRON["RF_SQ"]; bt = ENVIRON["RF_BT"]
        dq3 = dq dq dq; sq3 = sq sq sq
    }
    function isshell(f) { return (f ~ /\.(sh|bash|zsh|ksh)$/) }
    function isxml(f)   { return (f ~ /\.(xml|xhtml|plist)$/) }
    function marker(f) {
        if (f ~ /\.(py|rb|sh|bash|zsh|ksh|pl|pm|r|yaml|yml|toml|conf|cfg)$/) return "#"
        if (f ~ /\.(sql|lua|hs|elm|adb|ads)$/) return "--"
        return "//"
    }
    # One left-to-right pass over the line, carrying state between lines.
    # Strings and comments are recognised in the same scan, because doing them
    # in two passes gets both wrong: a // inside a string is not a comment, and
    # an apostrophe inside a comment is not a string.
    function strip(s,   out, n, i, c, c3, j, d, cj, p) {
        out = ""; n = length(s); i = 1; hpos = 0
        while (i <= n) {
            if (st == "blk") {
                p = index(substr(s, i), blkend)
                if (p == 0) return out
                i = i + p + length(blkend) - 1; st = ""
                continue
            }
            c = substr(s, i, 1)
            if (st == "str") {
                # An interpolated expression inside a string IS code.
                # "key=${store.fingerprint()}" is a real call, and blanking it
                # is how a live symbol was reported dead on real Kotlin: both
                # of its call sites sat inside string templates.
                if (c == "$" && substr(s, i + 1, 1) == "{") {
                    d = 0; j = i + 1
                    while (j <= n) {
                        cj = substr(s, j, 1)
                        if (cj == "{") d++
                        else if (cj == "}") { d--; if (d == 0) break }
                        j++
                    }
                    out = out " " substr(s, i + 2, j - i - 2) " "
                    i = j + 1
                    continue
                }
                if (c == "\\") { i += 2; continue }
                if (q == dq3 || q == sq3) {
                    if (substr(s, i, 3) == q) { st = ""; q = ""; i += 3; continue }
                } else if (c == q) { st = ""; q = ""; i++; continue }
                i++
                continue
            }
            # XML is the one place where a quoted value is not a literal to be
            # thrown away: `android:name=".CompanionApplication"` IS the wiring.
            # Only comments are stripped here, and they are <!-- --> rather than
            # anything the C-like branch below knows about.
            if (xml) {
                if (substr(s, i, 4) == "<!--") { st = "blk"; i += 4; continue }
                out = out c; i++
                continue
            }
            c3 = substr(s, i, 3)
            if (c3 == dq3 || c3 == sq3) { st = "str"; q = c3; i += 3; continue }
            if (c == dq || c == sq || c == bt) { st = "str"; q = c; i++; continue }
            if (m == "//" && substr(s, i, 2) == "/*") { st = "blk"; i += 2; continue }
            if (substr(s, i, length(m)) == m) {
                # In shell a # opens a comment only at the start of a word:
                # ${var#prefix} is an expansion. Treating it as a comment cut
                # the rest of the line, and on this very file that left 211
                # lines of "code" out of twelve hundred. Python is the other
                # way round - `x=1#c` IS a comment - so the rule is shell-only.
                if (m == "#" && shf && i > 1) {
                    p = substr(s, i - 1, 1)
                    if (p != " " && p != "\t") { out = out c; i++; continue }
                }
                return out
            }
            # Position of the first << that is really code. Remembered here
            # because only this scan knows what is a string and what is a
            # comment; looking for << in the raw line made a comment saying
            # "<< is a shift" open a heredoc and blank the rest of the file.
            if (hpos == 0 && c == "<" && substr(s, i + 1, 1) == "<") hpos = i
            out = out c; i++
        }
        return out
    }
    FNR == 1 {
        st = ""; q = ""; hw = ""; m = marker(FILENAME); shf = isshell(FILENAME)
        xml = isxml(FILENAME); blkend = xml ? "-->" : "*/"
        # A file with no extension is not a mystery - its first line says what
        # it is. `bin/redfirst` and `tests/run` are exactly such files, and
        # without this their # comments were never stripped: the pass was
        # weakest on the files this project edits most. Read, not guessed.
        if ($0 ~ /^#!/) {
            if ($0 ~ /(dash|bash|zsh|ksh|[^a-z]sh)([[:space:]]|$)/) { m = "#"; shf = 1 }
            else if ($0 ~ /(python|perl|ruby|awk|tclsh)/)           { m = "#"; shf = 0 }
        }
    }
    {
        raw = $0
        if (ENVIRON["RF_NOSTRIP"] == "1") code = raw
        else if (st == "here") {
            t = raw; sub(/^[ \t]+/, "", t); sub(/[ \t]+$/, "", t)
            if (t == hw) { st = ""; hw = "" }
            code = ""
        } else {
            code = strip(raw)
            # Only a triple quote or a backtick spans lines. A single quote or
            # double quote left open at end of line is an apostrophe in prose,
            # not a string: carrying it over blanked the rest of the file.
            if (st == "str" && q != dq3 && q != sq3 && q != bt) { st = ""; q = "" }
            # Shell heredoc. Restricted to shell files because << is a shift
            # operator everywhere else.
            if (shf && st == "") {
                p = hpos
                if (p > 0) {
                    w = substr(raw, p + 2)
                    sub(/^-/, "", w)
                    sub(/^[ \t]+/, "", w)
                    c = substr(w, 1, 1)
                    if (c == dq || c == sq) w = substr(w, 2)
                    if (match(w, /^[A-Za-z_][A-Za-z0-9_]*/)) {
                        hw = substr(w, 1, RLENGTH); st = "here"
                    }
                }
            }
        }
        # Emit mode: hand back the code with strings and comments already gone,
        # instead of classifying one symbol. `changed` needs the same stripping
        # this program does for `wired`, and writing a second stripper next to a
        # tested one is how the two drift apart.
        if (ENVIRON["RF_EMIT"] == "1") { print code; next }
        if (code ~ ENVIRON["RF_SYM"]) {
            if (code ~ ENVIRON["RF_IMP"]) bucket = "imp"
            else                          bucket = "code"
        } else if (raw ~ ENVIRON["RF_SYM"]) {
            bucket = "text"
        } else next
        printf "%s\t%s\t%s:%d:%s\n", bucket, FILENAME, FILENAME, FNR, raw
    }
'

# ── wired ────────────────────────────────────────────────────────────────────

cmd_wired() {
    [ $# -ge 1 ] || die 'usage: redfirst wired <Symbol>'
    symbol="$1"
    [ -n "$symbol" ] || die 'empty symbol name'
    [ "${#symbol}" -le "$MAX_SYMBOL" ] || die "name longer than $MAX_SYMBOL characters"
    file_list_or_die

    esc=$(esc_ere "$symbol")
    re=$(bound "$esc")
    grep_sources "$re" > "$TMP/hits" 2>/dev/null || true
    total=$(grep -c . < "$TMP/hits" || true)

    if [ "$total" = "0" ]; then
        printf 'redfirst wired "%s": the symbol does not occur at all (0 matches).\n' "$symbol"
        printf 'A typo in the name, or it is outside the scanned masks. This is NOT a verdict about dead code.\n'
        exit 2
    fi

    cut -d: -f1 "$TMP/hits" | sort -u > "$TMP/hitfiles"

    # The file list reaches awk as QUOTED positional parameters. It used to be
    # an unquoted `$(cat …)`: a path with a space split into two names that do
    # not exist, awk read nothing at all, and the report printed "всего
    # совпадений 4" with zero in every bucket, followed by a categorical
    # verdict — arithmetic that does not add up, delivered with confidence.
    set --
    while IFS= read -r f; do set -- "$@" "$f"; done < "$TMP/hitfiles"

    # Break point. RF_NOSTRIP makes the classifier read raw lines, so a symbol
    # named only in a comment counts as real use — the 0.1.0 failure this awk
    # block exists to prevent, and the only thing the suite can check it by.
    _rf_nostrip=0
    _broken strings && _rf_nostrip=1
    # Quote characters travel through the environment so this program can be
    # written inside single quotes without escaping gymnastics. Regexes travel
    # the same way: awk -v processes escape sequences and would eat the
    # backslash that makes `auth.login` a literal dot.
    RF_SYM="$re" RF_IMP="$import_re" RF_NOSTRIP="$_rf_nostrip" \
    RF_DQ='"' RF_SQ=$(printf '\47') RF_BT='`' \
    awk "$CLASSIFIER" "$@" > "$TMP/cls" 2>/dev/null || : > "$TMP/cls"

    # The unit is the FILE, not the hit. A declaration needs no recognising:
    # it is simply the one file the name occurs in.
    grep "^code	" "$TMP/cls" 2>/dev/null | cut -f2 | sort -u > "$TMP/codefiles"
    cut -f2 "$TMP/cls" 2>/dev/null | sort -u > "$TMP/allfiles"
    comm -23 "$TMP/allfiles" "$TMP/codefiles" > "$TMP/textfiles"
    nall=$(grep -c . < "$TMP/allfiles" || true)
    ncode=$(grep -c . < "$TMP/codefiles" || true)
    ntext=$(grep -c . < "$TMP/textfiles" || true)
    nhits=$(grep -c "^code	" "$TMP/cls" || true)
    # Break point: shifts the one-file threshold, so every "мёртв" verdict must
    # turn into "жив" and the suite must notice.
    _broken single && ncode=$((ncode + 1))

    printf 'redfirst wired "%s"\n' "$symbol"
    scanned_root_note
    printf '  files mentioning it   %s\n' "$nall"
    printf '  of those, in code     %s\n' "$ncode"
    printf '  outside code only     %s\n' "$ntext"
    printf '  mentions in code      %s\n' "$nhits"

    if [ "$ncode" = "0" ]; then
        printf 'THE NAME OCCURS NOWHERE IN CODE - only in strings, comments and imports:\n'
        grep -v "^code	" "$TMP/cls" | cut -f3 | head -n 5 | sed 's/^/  /'
        printf 'A mention is not a use. This thing is not in the running system.\n'
        exit 1
    fi
    if [ "$ncode" = "1" ]; then
        # One file, one mention: nothing names this, including itself. One file,
        # several mentions: it is used, but only by its own file. The two need
        # different words — a private helper is normal, a service nobody outside
        # calls is not — and the difference is countable without parsing syntax.
        if [ "$nhits" = "1" ]; then
            printf 'A SINGLE MENTION in the whole project:\n'
            grep "^code	" "$TMP/cls" | cut -f3 | sed 's/^/  /'
            printf 'If that is the declaration, the thing is dead: nothing names it, itself included.\n'
            printf 'If that is a call, the declaration lies outside the scanned masks.\n'
        else
            printf 'ONLY INSIDE ITS OWN FILE: %s mentions, all in one file.\n' "$nhits"
            grep "^code	" "$TMP/cls" | cut -f3 | head -n 8 | sed 's/^/  /'
            printf 'Outside this file the name does not appear. For a private helper that is normal;\n'
            printf 'for a class or a service it is a reason to ask who was supposed to call it.\n'
            # A mention is not a user, and this branch is where the two are
            # easiest to confuse: `type DeadThing struct{}` plus
            # `func (d DeadThing) Method()` counts two, and both of them are the
            # thing declaring itself. Telling declarations from calls needs the
            # parser that failed on six forms out of seven and was thrown away —
            # so the count stays honest and the reader is told what to look at.
            printf 'Read those lines before deciding: if they are only the declaration and its own\n'
            printf 'methods, then the mentions are the thing naming itself - the users are zero.\n'
        fi
        if [ "$ntext" != "0" ]; then
            printf 'Also mentioned outside code (not counted):\n'
            grep -v "^code	" "$TMP/cls" | cut -f3 | head -n 3 | sed 's/^/  /'
        fi
        exit 1
    fi
    printf 'ALIVE: the name occurs in code in %s files.\n' "$ncode"
    grep "^code	" "$TMP/cls" | cut -f3 | head -n 8 | sed 's/^/  /'
    # Без существительного: «3 упоминания» и «5 упоминаний» — разные формы,
    # а согласовывать числительное в shell дороже, чем оно стоит.
    [ "$nhits" -gt 8 ] && printf '  … and %s more\n' "$((nhits - 8))"
    # Said here rather than only in the README, because "ALIVE" is exactly the
    # word a reader turns into "works" — and this tool's audience is the one
    # that cannot check the difference by reading the code.
    printf 'This says the name is present. It says NOTHING about whether it is correct.\n'
    exit 0
}

# ── samples ──────────────────────────────────────────────────────────────────

cmd_samples() {
    [ $# -ge 1 ] || die 'usage: redfirst samples <pattern>'
    pattern="$1"
    file_list_or_die
    # Validity is decided by grep's exit code, not by matching the wording of its
    # error message. 0.2.0 pattern-matched the text, missed it on this grep, and
    # reported a broken expression as "0 совпадений" with a clean exit —
    # a failed check presented as a passed one.
    set +e
    printf '' | grep -E -- "$pattern" >/dev/null 2>&1
    rc=$?
    set -e
    [ "$rc" -gt 1 ] && die "not a valid regular expression: $pattern"
    grep_sources "$pattern" > "$TMP/hits" 2>/dev/null || true
    count=$(grep -c . < "$TMP/hits" || true)
    printf 'redfirst samples "%s": %s matches\n' "$pattern" "$count"
    [ "$count" = "0" ] && exit 1
    # First / middle / last, not the first three: the miscount this exists for
    # hid in the tail, and three consecutive lines from the top confirmed it.
    printf 'Samples from the start, the middle and the end - check this is what you meant to count:\n'
    if [ "$count" -le 3 ]; then
        sed 's/^/  /' "$TMP/hits"
    else
        mid=$(( (count + 1) / 2 ))
        sed -n "1p;${mid}p;${count}p" "$TMP/hits" | sed 's/^/  /'
    fi
    exit 0
}

# ── counter ──────────────────────────────────────────────────────────────────
# Absence claims scan EVERYTHING, including tests and vendor: a secret hiding in
# a fixture is still a secret, and 0.1.0 confirmed its absence.

cmd_counter() {
    [ $# -ge 1 ] || die 'usage: redfirst counter <term> [term...]'
    printf 'redfirst counter: searching for what is claimed absent (tests and vendor included).\n'
    scanned_root_note
    any=0
    for term in "$@"; do
        [ -n "$term" ] || continue
        esc=$(esc_ere "$term")
        # Status is captured directly. Inside `if ! out=$(...)`, $? is the status
        # of the negation — always 0 — so the whole "ОШИБКА ПОИСКА" branch below
        # was unreachable and a failed search silently confirmed absence.
        # Verified: `if ! out=$(sh -c "exit 2"); then echo $?; fi` prints 0.
        # -I is gone on purpose: a secret inside a binary fixture is still a secret.
        set +e
        out=$(grep -RnE -- "$esc" . 2>"$TMP/gerr")
        status=$?
        set -e
        if [ "$status" -gt 1 ]; then
            printf '  %-28s SEARCH FAILED - absence is NOT confirmed\n' "$term"
            [ -s "$TMP/gerr" ] && head -n 2 "$TMP/gerr" | sed 's/^/      /'
            any=2; continue
        fi
        if [ -s "$TMP/gerr" ]; then
            printf '  %-28s some paths unread - absence is NOT confirmed\n' "$term"
            head -n 2 "$TMP/gerr" | sed 's/^/      /'
            any=2; continue
        fi
        c=$(printf '%s' "$out" | grep -c . || true)
        printf '  %-28s %s\n' "$term" "$c"
        if [ "$c" != "0" ]; then
            any=1
            printf '%s\n' "$out" | head -n 2 | sed 's/^/      /'
        fi
    done
    if [ "$any" = "2" ]; then
        printf 'The search itself failed. Absence cannot be claimed.\n'; exit 2
    fi
    if [ "$any" = "1" ]; then
        printf 'Found. The claim of absence, as worded, is false.\n'; exit 1
    fi
    printf 'Not found. Attach this output to the claim of absence.\n'
    exit 0
}

# ── changed ──────────────────────────────────────────────────────────────────
# Каждая команда выше принимает имя, которое надо знать заранее. А человек,
# который не читает код, узнаёт это имя от ассистента — от той самой стороны,
# которую собирается проверить. Утверждение «почистил старый путь авторизации»
# проверить нечем: имени в нём нет.
#
# Эта команда достаёт кандидатов из самого изменения. Она НЕ разбирает синтаксис:
# распознавание объявлений выброшено после того, как провалилось на шести формах
# из семи, и возвращать его через заднюю дверь нельзя. Здесь только два вопроса,
# на которые отвечает grep:
#
#   ПОЯВИЛОСЬ — имя есть в добавленных строках и НЕТ во всей базе сравнения;
#   ИСЧЕЗЛО   — имя есть в удалённых строках и НЕТ во всём текущем состоянии.
#
# Первое проверяется через `wired`: подключено ли то, что появилось. Второе —
# через `counter`: не осталось ли ссылок на то, чего больше нет.
#
# Это кандидаты, а не вердикт, и так написано в выводе. Имена берутся из строк
# целиком, включая строки и комментарии: отделять одно от другого — снова разбор
# синтаксиса.

_CHANGED_MAX=200
# Документы из подсчёта исключены: слово из прозы не делает вещь подключённой.
_CH_NOT_CODE='\.(md|mdx|txt|rst|html)$'
_CHANGED_STOP='^(if|else|elif|then|fi|for|while|do|done|case|esac|switch|break|continue|return|function|func|class|struct|enum|interface|import|from|package|public|private|protected|internal|static|final|const|let|var|val|def|fun|new|this|self|null|nil|none|true|false|void|int|string|bool|float|double|char|byte|long|short|array|list|dict|map|set|type|typedef|extends|implements|override|abstract|throws|catch|try|finally|throw|raise|with|async|await|yield|lambda|print|printf|echo|test|assert|error|value|values|name|names|data|item|items|result|index|count|size|length|line|lines|file|files|path|paths|text|args|kwargs|param|params)$'

_is_source_path() {
    for _p in $(source_patterns); do
        case "$1" in $_p) return 0 ;; esac
    done
    # Файл без расширения с shebang — это тоже исходник: `bin/redfirst`,
    # `tests/run`, любой скрипт в bin/. Маски их не ловят по построению, и на
    # первом же пробном запуске `changed` пропустил главный файл самого
    # инструмента, отчитавшись «изменено файлов с кодом: 1».
    case "$1" in
        *.*) return 1 ;;
    esac
    [ -f "$1" ] || return 1
    IFS= read -r _first < "$1" 2>/dev/null || return 1
    case "$_first" in
        '#!'*) return 0 ;;
    esac
    return 1
}

cmd_changed() {
    base=${1:-HEAD}
    git rev-parse --git-dir >/dev/null 2>&1 || die 'not a git repository: nothing to compare against'
    git rev-parse --verify --quiet "$base" >/dev/null 2>&1 || die "comparison point not found: $base"

    printf 'redfirst changed: what appeared and what disappeared\n'
    scanned_root_note
    printf 'Comparing against: %s\n' "$base"

    git diff --name-only "$base" > "$TMP/ch.files" 2>/dev/null || : > "$TMP/ch.files"
    set --
    nsrc=0; nskip=0
    : > "$TMP/ch.srcfiles"
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        if is_noise "./$f" || ! _is_source_path "$f"; then
            nskip=$((nskip + 1)); continue
        fi
        nsrc=$((nsrc + 1))
        set -- "$@" "$f"
        printf '%s\n' "$f" >> "$TMP/ch.srcfiles"
    done < "$TMP/ch.files"

    # Неотслеживаемые файлы `git diff` не показывает вовсе, а «ассистент только
    # что написал новый файл» — самый частый случай из всех. Найдено случаем
    # changed-new-symbol на первом же прогоне: команда отвечала «изменений в
    # коде нет» при двух новых файлах в дереве.
    git ls-files --others --exclude-standard > "$TMP/ch.untracked" 2>/dev/null \
        || : > "$TMP/ch.untracked"
    : > "$TMP/ch.newfiles"
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        if is_noise "./$f" || ! _is_source_path "$f"; then
            nskip=$((nskip + 1)); continue
        fi
        nsrc=$((nsrc + 1))
        printf '%s\n' "$f" >> "$TMP/ch.newfiles"
        printf '%s\n' "$f" >> "$TMP/ch.srcfiles"
    done < "$TMP/ch.untracked"

    if [ "$nsrc" = "0" ]; then
        printf 'No changed files contain source code (%s skipped: tests, build output, non-code).\n' "$nskip"
        printf 'Nothing to check here. This is NOT a verdict that the change is safe.\n'
        exit 2
    fi
    printf 'Changed files with code: %s (%s skipped)\n\n' "$nsrc" "$nskip"

    # Кавыченные позиционные параметры, а не $(cat): путь с пробелом распадался
    # на два несуществующих, и та же ошибка уже стоила `wired` целого вердикта.
    git diff -U0 "$base" -- "$@" > "$TMP/ch.diff" 2>/dev/null || : > "$TMP/ch.diff"
    grep '^+' "$TMP/ch.diff" | grep -v '^+++' > "$TMP/ch.add" 2>/dev/null || : > "$TMP/ch.add"
    grep '^-' "$TMP/ch.diff" | grep -v '^---' > "$TMP/ch.del" 2>/dev/null || : > "$TMP/ch.del"
    # Новый файл целиком — добавленные строки.
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        cat "$f" >> "$TMP/ch.add" 2>/dev/null || true
    done < "$TMP/ch.newfiles"

    # Слова из КОДОВЫХ позиций изменённых файлов — тем же разборщиком, что и в
    # `wired`. Оговорка Д1 звучала так: слово из комментария встречается дважды
    # в двух файлах, переживает оба отсева и встаёт в список рядом с настоящим
    # именем. На первом прогоне на живом коммите таких было больше половины.
    #
    # Это НЕ возврат разбора синтаксиса: объявление по-прежнему не опознаётся.
    # Вычищаются строки и комментарии — та часть, которая осталась после
    # выброса `is_decl_re` именно потому, что работала.
    set --
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        set -- "$@" "$f"
    done < "$TMP/ch.srcfiles"
    RF_SYM='.' RF_IMP="$import_re" RF_NOSTRIP=0 RF_EMIT=1 \
    RF_DQ='"' RF_SQ=$(printf '\47') RF_BT='`' \
    awk "$CLASSIFIER" "$@" 2>/dev/null > "$TMP/ch.codetext" || : > "$TMP/ch.codetext"

    # То же самое для БАЗЫ сравнения: слово, пропавшее из комментария, — это не
    # пропавшая вещь. Содержимое достаётся `git show`, расширение сохраняется в
    # имени копии, а для файлов без расширения работает шебанг.
    : > "$TMP/ch.baselist"
    _bi=0
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        _bi=$((_bi + 1))
        _bn=${f##*/}
        case $_bn in
            *.*) _bf="$TMP/base.$_bi.${_bn##*.}" ;;
            *)   _bf="$TMP/base.$_bi" ;;
        esac
        if git show "$base:$f" > "$_bf" 2>/dev/null; then
            printf '%s\n' "$_bf" >> "$TMP/ch.baselist"
        else
            rm -f "$_bf"        # новый файл базы не имеет — это не ошибка
        fi
    done < "$TMP/ch.srcfiles"
    : > "$TMP/ch.basetext"
    if [ -s "$TMP/ch.baselist" ]; then
        set --
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            set -- "$@" "$f"
        done < "$TMP/ch.baselist"
        RF_SYM='.' RF_IMP="$import_re" RF_NOSTRIP=0 RF_EMIT=1 \
        RF_DQ='"' RF_SQ=$(printf '\47') RF_BT='`' \
        awk "$CLASSIFIER" "$@" 2>/dev/null > "$TMP/ch.basetext" || : > "$TMP/ch.basetext"
    fi

    _words() {   # файл -> отсортированный список слов
        tr -cs 'A-Za-z0-9_' '\n' < "$1" \
            | grep -E '^[A-Za-z_][A-Za-z0-9_]{3,}$' \
            | grep -Ev "$_CHANGED_STOP" \
            | sort -u
    }
    _words "$TMP/ch.add" > "$TMP/ch.addw"
    _words "$TMP/ch.del" > "$TMP/ch.delw"
    _words "$TMP/ch.codetext" > "$TMP/ch.codew"
    _words "$TMP/ch.basetext" > "$TMP/ch.basew"

    # Пустой разбор означает, что вычистка не отработала, а не что кода нет.
    # Молча вычесть всё было бы худшим исходом из возможных: команда сказала бы
    # «проверять нечего» ровно тогда, когда сама сломалась.
    dropped_prose=0
    if [ -s "$TMP/ch.codew" ]; then
        comm -12 "$TMP/ch.addw" "$TMP/ch.codew" > "$TMP/ch.addw.code" 2>/dev/null \
            || cp "$TMP/ch.addw" "$TMP/ch.addw.code"
        dropped_prose=$(( $(grep -c . < "$TMP/ch.addw" || true) \
                        - $(grep -c . < "$TMP/ch.addw.code" || true) ))
        mv -f "$TMP/ch.addw.code" "$TMP/ch.addw"
    else
        warn 'the code/comment pass produced nothing - prose is NOT filtered out of the list below'
    fi
    if [ -s "$TMP/ch.basew" ]; then
        comm -12 "$TMP/ch.delw" "$TMP/ch.basew" > "$TMP/ch.delw.code" 2>/dev/null \
            || cp "$TMP/ch.delw" "$TMP/ch.delw.code"
        dropped_prose=$(( dropped_prose + $(grep -c . < "$TMP/ch.delw" || true) \
                        - $(grep -c . < "$TMP/ch.delw.code" || true) ))
        mv -f "$TMP/ch.delw.code" "$TMP/ch.delw"
    fi

    nadd=$(grep -c . < "$TMP/ch.addw" || true)
    ndel=$(grep -c . < "$TMP/ch.delw" || true)
    capped=0
    if [ "$((nadd + ndel))" -gt "$_CHANGED_MAX" ]; then
        capped=$((nadd + ndel))
        head -n "$_CHANGED_MAX" "$TMP/ch.addw" > "$TMP/ch.addw.cap"; mv "$TMP/ch.addw.cap" "$TMP/ch.addw"
        head -n "$_CHANGED_MAX" "$TMP/ch.delw" > "$TMP/ch.delw.cap"; mv "$TMP/ch.delw.cap" "$TMP/ch.delw"
    fi

    # Появилось = нет во всей базе сравнения. Исчезло = нет во всём текущем.
    #
    # Плюс два отсева, без которых список бесполезен тому, ради кого написан.
    # Первый прогон на настоящем коммите дал сорок три кандидата, из которых
    # больше половины были английские слова из комментариев — «unverifiable»,
    # «accumulates», «anyone».
    #
    #   * имя, встречающееся ОДИН раз во всём дереве, — это упоминание, а не
    #     вещь: ровно тот же довод, по которому `wired` называет такое мёртвым;
    #   * имя, разошедшееся по трём и более файлам, заведомо подключено, и
    #     спрашивать про него `wired` незачем.
    #
    # Остаётся то, про что `wired` скажет что-то содержательное. Сколько отсеяно
    # — печатается: молчаливое сокращение списка читалось бы как «больше ничего
    # и не было».
    : > "$TMP/ch.new"; : > "$TMP/ch.gone"
    dropped_once=0; dropped_spread=0
    while IFS= read -r w; do
        [ -n "$w" ] || continue
        # Считаем по КОДУ, а не по документам. Первый прогон оставил в списке
        # «unverifiable», «anyone», «accumulates»: они встречались дважды —
        # один раз в комментарии и один раз в английском README. Проза не
        # подключает ничего.
        if git grep -l -F -e "$w" "$base" 2>/dev/null | grep -qvE "$_CH_NOT_CODE"; then
            continue                       # уже было в коде базы — не новое
        fi
        _nf=$(git grep --untracked -l -F -e "$w" 2>/dev/null | grep -vE "$_CH_NOT_CODE" | grep -c . || true)
        _nh=$(git grep --untracked -F -e "$w" 2>/dev/null | grep -vE "^[^:]*\.(md|mdx|txt|rst|html):" | grep -c . || true)
        if [ "$_nh" -le 1 ]; then dropped_once=$((dropped_once + 1)); continue; fi
        if [ "$_nf" -ge 3 ]; then dropped_spread=$((dropped_spread + 1)); continue; fi
        printf '%s\n' "$w" >> "$TMP/ch.new"
    done < "$TMP/ch.addw"
    while IFS= read -r w; do
        [ -n "$w" ] || continue
        git grep -q -F -- "$w" >/dev/null 2>&1 || printf '%s\n' "$w" >> "$TMP/ch.gone"
    done < "$TMP/ch.delw"

    nnew=$(grep -c . < "$TMP/ch.new" || true)
    ngone=$(grep -c . < "$TMP/ch.gone" || true)

    if [ "$nnew" != "0" ]; then
        printf 'APPEARED - these names were absent from the comparison base. Is it wired in:\n'
        while IFS= read -r w; do printf '  redfirst wired %s\n' "$w"; done < "$TMP/ch.new"
        printf '\n'
    fi
    if [ "$ngone" != "0" ]; then
        printf 'DISAPPEARED - these names are absent now. Any references left:\n'
        while IFS= read -r w; do printf '  redfirst counter %s\n' "$w"; done < "$TMP/ch.gone"
        printf '\n'
    fi

    printf 'These are CANDIDATES, not a verdict. Names are taken from code positions\n'
    printf 'only - strings and comments are stripped by the same pass wired uses - so\n'
    printf 'local variables are still among them, but prose is not. Which of them is a\n'
    printf 'thing worth checking is a question this list opens, not one it closes.\n'
    if [ "$((dropped_once + dropped_spread + dropped_prose))" != "0" ]; then
        printf 'Filtered out: %s occur once in the whole tree (a mention,\n' "$dropped_once"
        printf 'not a thing), %s span three files or more (wired in beyond doubt),\n' "$dropped_spread"
        printf '%s live only in comments and strings.\n' "$dropped_prose"
    fi
    if [ "$capped" != "0" ]; then
        printf 'WARNING: %s words in the change, showing the first %s of each side.\n' \
               "$capped" "$_CHANGED_MAX"
        printf 'The list is incomplete - narrow the comparison to a single commit.\n'
    fi
    [ "$((nnew + ngone))" = "0" ] && {
        printf 'No new and no disappeared names - nothing to check.\n'
        exit 0
    }
    exit 1
}

# ── red / green ──────────────────────────────────────────────────────────────
# The rule this tool is named after was, until now, the only one it did not
# enforce: "show how it fails before calling it done" lived in CLAUDE.md as a
# request. A request is exactly the kind of unverifiable claim the rest of this
# file exists to refuse — the instrument stood on the thing it distrusts.
#
# So `red` and `green` do not take anyone's word for it. They RUN the command
# and check the outcome themselves:
#
#   red   — the command must FAIL. Claiming red on something that passes is
#           refused, and nothing is written: there was no failing check.
#   green — the command must PASS, and a red with the same wording must already
#           be in the journal. Green with no red before it proves nothing.
#
# What accumulates is a journal a non-reader can open: what was claimed broken,
# on what date, by which command, and whether it ever went green.

LEDGER="$CONFIG_DIR/ledger"

# Which code the entry is about. Without it the journal reads, a week later, as
# "the hook reaches the human — red 17.08, green 17.08" and matches no change
# in the repository: there is nothing to look at next to the claim.
#
# The tree state is part of the answer. A red recorded while the working tree
# differs from HEAD is only approximately located at HEAD, and saying so is
# cheaper than being wrong about it later. The tool's own config directory does
# not count as a change — otherwise the second entry would always be blaming
# the first one for existing.
_code_at() {
    git rev-parse --git-dir >/dev/null 2>&1 || { printf 'not-a-repo'; return 0; }
    _h=$(git rev-parse HEAD 2>/dev/null) || _h=""
    [ -n "$_h" ] || { printf 'no-commit'; return 0; }
    _st=$(git status --porcelain 2>/dev/null | grep -vF "$CONFIG_DIR" | head -n 1)
    if [ -n "$_st" ]; then printf '%s+dirty' "$_h"; else printf '%s' "$_h"; fi
}

_ledger_append() {   # дата, состояние, код, команда, утверждение, коммит
    mkdir -p "$CONFIG_DIR"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" "$6" >> "$LEDGER"
}

# Last recorded state for a claim; empty when the claim is unknown.
# Six fields are read, not five: with five the last variable would swallow
# "claim<TAB>commit" and the exact-wording match — the whole key linking a red
# to its green — would never hold again.
_ledger_state=""
_ledger_last_state() {
    _ledger_state=""
    [ -f "$LEDGER" ] || return 0
    while IFS='	' read -r _ld _ls _lc _lcmd _lclaim _lcommit || [ -n "$_lclaim" ]; do
        # `if/fi`, не `&&`. Если последняя строка журнала не про это
        # утверждение, `&&` оставляет статус 1: он становится статусом цикла,
        # затем функции, и `set -e` убивает вызывающего. Поймано на живом
        # запуске — `log` печатал журнал и выходил единицей, не сказав ни слова
        # о том, что открыто.
        if [ "$_lclaim" = "$1" ]; then _ledger_state=$_ls; fi
    done < "$LEDGER"
    return 0
}

_open_claims() {
    [ -f "$LEDGER" ] || return 0
    cut -f5 "$LEDGER" | sort -u | while IFS= read -r c; do
        [ -n "$c" ] || continue
        _ledger_last_state "$c"
        # `if/fi`, не `&&`: при закрытом утверждении `&&` оставляет статус 1,
        # он становится статусом цикла, потом подстановки, и `set -e` убивает
        # команду молча — журнал печатался и выходил единицей без единого слова.
        if [ "$_ledger_state" = "red" ]; then printf '%s\n' "$c"; fi
    done
    return 0
}

_red_green() {
    want=$1; shift
    [ $# -ge 1 ] || die "usage: redfirst $want \"<what you are checking>\" -- <command>"
    claim=$(trim "$1"); shift
    [ -n "$claim" ] || die 'empty claim - a journal entry with no name is useless'
    case $claim in
        *'	'*) die 'no tabs in the claim: a tab separates journal fields' ;;
    esac
    [ "${1:-}" = "--" ] || die "after the claim you need -- and the command that checks it"
    shift
    [ $# -ge 1 ] || die 'no command given after --'

    printf 'redfirst %s: %s\n' "$want" "$claim"
    printf 'Running: %s\n' "$*"
    set +e
    "$@" > "$TMP/rg" 2>&1
    rc=$?
    set -e
    printf 'Exit code: %s. Last lines of output:\n' "$rc"
    tail -n 6 "$TMP/rg" | sed 's/^/  /'

    today=$(date +%Y-%m-%d)
    at=$(_code_at)
    if [ "$want" = "red" ]; then
        if [ "$rc" = "0" ]; then
            printf 'REFUSED: the command succeeded, and you declared it red.\n'
            printf 'Nothing to record: there was no failing check.\n'
            exit 2
        fi
        _ledger_append "$today" red "$rc" "$*" "$claim" "$at"
        printf 'Recorded RED. Close it with: redfirst green "%s" -- <the same command>\n' "$claim"
        exit 0
    fi

    _ledger_last_state "$claim"
    # Точка слома: принимать зелёное без предшествующего красного. Это ровно
    # то правило, ради которого инструмент назван, и набор обязан уметь
    # заметить его пропажу.
    _broken redgreen && _ledger_state=red
    if [ "$_ledger_state" != "red" ]; then
        printf 'REFUSED: no red with this wording is in the journal.\n'
        printf 'Green without a red proves nothing. Show how it fails first.\n'
        if [ -f "$LEDGER" ]; then
            printf 'Open reds right now:\n'
            _open_claims | sed 's/^/  /'
        fi
        exit 2
    fi
    if [ "$rc" != "0" ]; then
        printf 'Still red (exit %s). Not recording: there was no transition.\n' "$rc"
        exit 1
    fi
    _ledger_append "$today" green 0 "$*" "$claim" "$at"
    printf 'Recorded GREEN. The red-to-green transition is shown and recorded.\n'
    exit 0
}

# ── drop ─────────────────────────────────────────────────────────────────────
# The key linking a red to its green is the exact wording, and that is
# deliberate: it is what stops one check from closing another. The cost is that
# a typo creates an entry nothing can ever close, and `log` shows it open for
# ever. An instrument whose journal fills with undeletable noise stops being
# read, and an unread journal proves nothing.
#
# So there is a way out, and it is loud. Withdrawing is itself an entry: the red
# stays, the withdrawal stands next to it with its reason, and neither can be
# mistaken for a check that passed. Silent deletion is not offered at all — an
# entry that vanished is worse than a wrong one, because nothing is left to say
# it was ever there.
cmd_drop() {
    [ $# -ge 1 ] || die 'usage: redfirst drop "<the exact wording>" -- <why you are withdrawing it>'
    claim=$(trim "$1"); shift
    [ -n "$claim" ] || die 'empty claim - there is nothing to withdraw'
    case $claim in
        *'	'*) die 'no tabs in the claim: a tab separates journal fields' ;;
    esac
    [ "${1:-}" = "--" ] || die 'after the claim you need -- and the reason for withdrawing it'
    shift
    reason=$(trim "$*")
    [ -n "$reason" ] || die 'no reason given - a withdrawal without one is a silent deletion by another door'
    case $reason in
        *'	'*) die 'no tabs in the reason: a tab separates journal fields' ;;
    esac

    _ledger_last_state "$claim"
    if [ "$_ledger_state" != "red" ]; then
        printf 'REFUSED: no open red with this wording is in the journal.\n'
        printf 'Withdrawing applies to what is open. Nothing here matches, so nothing is written:\n'
        printf 'otherwise this command would be a way to put any text into the journal at all.\n'
        if [ -f "$LEDGER" ]; then
            printf 'Open reds right now:\n'
            _open_claims | sed 's/^/  /'
        fi
        exit 2
    fi

    today=$(date +%Y-%m-%d)
    _ledger_append "$today" drop - "dropped: $reason" "$claim" "$(_code_at)"
    printf 'redfirst drop: %s\n' "$claim"
    printf 'Reason: %s\n' "$reason"
    printf 'Withdrawn. Both entries stay in the journal - nothing was deleted, and this\n'
    printf 'is NOT a green: closing it green again requires showing a red again first.\n'
    exit 0
}

cmd_log() {
    if [ ! -f "$LEDGER" ]; then
        printf 'redfirst: the check journal is empty.\n'
        printf 'No check has been shown red yet. Start with:\n'
        printf '  redfirst red "<what you are checking>" -- <command>\n'
        exit 2
    fi
    printf 'redfirst: check journal (%s)\n\n' "$LEDGER"
    while IFS='	' read -r d s c cmd claim at || [ -n "$claim" ]; do
        [ -n "$claim" ] || continue
        # Entries written before the commit field existed do not carry one, and
        # they are shown as they are. Rewriting a journal after the fact is the
        # silent correction this tool exists to refuse.
        case $at in
            '') at='—' ;;
            *)  _sfx=''; case $at in *+dirty) _sfx='+dirty' ;; esac
                at="$(printf '%.7s' "$at")$_sfx" ;;
        esac
        # A withdrawal ran no command, so it has no exit code. Printing
        # "exit -" for it would be a field filled in for the sake of the column.
        case $s in
            drop) printf '  %s  %-6s %-8s %s\n' "$d" "$s" "" "$claim" ;;
            *)    printf '  %s  %-6s exit %-3s %s\n' "$d" "$s" "$c" "$claim" ;;
        esac
        printf '              %-14s %s\n' "$at" "$cmd"
    done < "$LEDGER"
    printf '\n'
    open=$(_open_claims)
    if [ -n "$open" ]; then
        n=$(printf '%s\n' "$open" | grep -c .)
        printf 'OPEN (shown red and not closed): %s\n' "$n"
        printf '%s\n' "$open" | sed 's/^/  /'
        exit 1
    fi
    # A withdrawal is not a green, and the closing line may not say it is. The
    # two outcomes differ exactly the way "could not check" differs from "fine",
    # and blurring them here would undo the point of recording the withdrawal.
    ndrop=$(cut -f2 "$LEDGER" | grep -c '^drop$' || true)
    if [ "$ndrop" != "0" ]; then
        printf 'Nothing is open. Withdrawn with a reason: %s - those were never shown green.\n' "$ndrop"
        exit 0
    fi
    printf 'Everything shown red has been closed green.\n'
    exit 0
}

# ── due ──────────────────────────────────────────────────────────────────────
# Any field this cannot parse counts as OVERDUE. 0.1.0 treated an unreadable
# date, a non-numeric period and a stray separator as "fine" and printed green.

# Date handling is pure arithmetic — no `date` fork per asset and no dependence
# on whether this machine has GNU or BSD date. `due` runs at every session start;
# 0.2.x spent nine forks per line and took tens of seconds on a long registry,
# which is a cost people respond to by deleting the hook.
# Sets _days to days since 1970-01-01, or returns 1 for anything unparseable.
# Strips leading zeros without a fork and without the non-POSIX base# prefix.
_d=0
dec() {
    _d=$1
    while :; do case $_d in 0?*) _d=${_d#0} ;; *) break ;; esac; done
    [ -n "$_d" ] || _d=0
}

_days=0
parse_date() {
    if _broken dates; then _days=0; return 0; fi
    case "$1" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
        *) return 1 ;;
    esac
    y=${1%%-*}; rest=${1#*-}; mo=${rest%%-*}; d=${rest#*-}
    # NOT $((10#$mo)): the base# prefix is a bash/ksh extension. On Debian and
    # Raspberry Pi OS /bin/sh is dash, where $((10#08)) is a syntax error — so
    # every date in August or September crashed the whole command. Verified on
    # the target platform, not assumed.
    dec "$y";  y=$_d
    dec "$mo"; mo=$_d
    dec "$d";  d=$_d
    [ "$mo" -ge 1 ] && [ "$mo" -le 12 ] || return 1
    case $mo in
        1|3|5|7|8|10|12) dim=31 ;;
        4|6|9|11) dim=30 ;;
        *) if [ $(( (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 )) -eq 1 ]
           then dim=29; else dim=28; fi ;;
    esac
    [ "$d" -ge 1 ] && [ "$d" -le "$dim" ] || return 1   # rejects 2026-02-30
    # days_from_civil, restricted to y >= 0 which holds for every real date here
    yy=$y
    [ "$mo" -le 2 ] && yy=$((y - 1))
    if [ "$mo" -gt 2 ]; then mm=$((mo - 3)); else mm=$((mo + 9)); fi
    era=$((yy / 400)); yoe=$((yy - era * 400))
    doy=$(( (153 * mm + 2) / 5 + d - 1 ))
    doe=$(( yoe * 365 + yoe / 4 - yoe / 100 + doy ))
    _days=$(( era * 146097 + doe - 719468 ))
    return 0
}

# Parameter-expansion replacements for trim and cut: same result, no fork.
_f1=""; _f2=""; _f3=""
split3() {
    l=$1
    _f1=${l%%|*}
    if [ "$l" = "$_f1" ]; then _f2=""; _f3=""; else
        r=${l#*|}; _f2=${r%%|*}
        if [ "$r" = "$_f2" ]; then _f3=""; else r2=${r#*|}; _f3=${r2%%|*}; fi
    fi
    for v in 1 2 3; do
        eval "t=\$_f$v"
        while :; do case $t in [[:space:]]*) t=${t#?} ;; *) break ;; esac; done
        while :; do case $t in *[[:space:]]) t=${t%?} ;; *) break ;; esac; done
        eval "_f$v=\$t"
    done
}

cmd_due() {
    quiet=0
    [ "${1:-}" = "--quiet" ] && quiet=1
    # --quiet silences the success line and nothing else. It used to swallow
    # every failure mode too, so a missing or unreadable registry made the
    # session-start hook print nothing at all — indistinguishable from "clean".
    if [ ! -e "$ASSETS" ]; then
        die "no $ASSETS. Run: redfirst init"
    fi
    [ -f "$ASSETS" ] || die "$ASSETS is not a regular file"
    [ -r "$ASSETS" ] || die "$ASSETS is not readable"
    # Today, and the whole file's line endings, normalised once instead of per
    # line. A lone CR is turned into a newline too: a registry saved with classic
    # Mac endings used to arrive as one giant line and every asset vanished.
    today=$(date +%Y-%m-%d)
    parse_date "$today" || die "could not parse today's date ($today)"
    now_days=$_days
    tr '\r' '\n' < "$ASSETS" > "$TMP/assets.norm"
    bad=0; total=0; out="$TMP/out"; : > "$out"

    first=1
    # `|| [ -n "$raw" ]` keeps the final line when the file has no trailing
    # newline — 0.1.0 dropped it and reported all-clear.
    while IFS= read -r raw || [ -n "$raw" ]; do
        line=$raw
        if [ "$first" = 1 ]; then line=${line#"$BOM"}; first=0; fi
        case $line in
            '') continue ;;
        esac
        # Leading whitespace is stripped BEFORE the comment test. The glob
        # `[[:space:]]*\#*` reads as "one space, anything, a hash, anything",
        # so " Ключ подписи #1 | never | 90" was silently dropped as a comment
        # — an indented asset with a hash in its name vanished from the count.
        stripped=$line
        while :; do case $stripped in [[:space:]]*) stripped=${stripped#?} ;; *) break ;; esac; done
        case $stripped in
            ''|\#*) continue ;;
        esac
        case $line in *[![:space:]]*) ;; *) continue ;; esac
        total=$((total + 1))

        split3 "$line"
        name=$_f1; verified=$_f2; period=$_f3

        if [ -z "$name" ]; then
            printf '  ! line with no name: "%s" - not parsed\n' "$line" >> "$out"; bad=$((bad+1)); continue
        fi
        case "$period" in
            ''|*[!0-9]*) printf '  ! %s - period "%s" is not a number, the check does not apply\n' "$name" "$period" >> "$out"; bad=$((bad+1)); continue ;;
        esac
        dec "$period"; [ "$_d" -gt 0 ] 2>/dev/null || { printf '  ! %s - the period must be greater than zero\n' "$name" >> "$out"; bad=$((bad+1)); continue; }
        period=$_d

        case $verified in
            [Nn][Ee][Vv][Ee][Rr]|'')
                printf '  ! %s - restoring it has NEVER been checked\n' "$name" >> "$out"; bad=$((bad+1)); continue ;;
        esac
        if ! parse_date "$verified"; then
            printf '  ! %s - date "%s" not parsed (format must be YYYY-MM-DD)\n' "$name" "$verified" >> "$out"; bad=$((bad+1)); continue
        fi
        vep=$_days
        if [ "$vep" -gt "$now_days" ]; then
            printf '  ! %s - date "%s" is in the future, probably a typo\n' "$name" "$verified" >> "$out"; bad=$((bad+1)); continue
        fi
        age=$(( now_days - vep ))
        if [ "$age" -gt "$period" ]; then
            printf '  ! %s - checked %s days ago, the limit is %s\n' "$name" "$age" "$period" >> "$out"; bad=$((bad+1))
        fi
    done < "$TMP/assets.norm"

    # Where this prints decides whether the tool works at all, and the rule is
    # not symmetric. Documented behaviour of a SessionStart hook: on exit 0 its
    # stdout is handed to the MODEL as context; on a non-zero exit its stderr is
    # shown to the USER. 0.4.x printed to stdout and exited 1 — the single
    # automatic guarantee of the product reached nobody, ever.
    #
    # Hook mode therefore writes to stderr and exits non-zero: the only
    # combination that reaches a person. Reaching the model instead would be
    # this tool quietly telling the party under check that a check is overdue,
    # which is the arrangement it exists to replace.
    say() {
        if _broken quiet; then printf '%s\n' "$1"; return; fi
        if [ "$quiet" = 1 ]; then printf '%s\n' "$1" >&2; else printf '%s\n' "$1"; fi
    }

    if [ "$total" = "0" ]; then
        # An empty registry is the state right after installation, and silence
        # here is indistinguishable from "everything checked".
        say 'redfirst: the list of irreplaceable assets is empty - add yours to .redfirst/irreplaceable.'
        exit 1
    fi
    if [ "$bad" -gt 0 ]; then
        if _broken quiet; then cat "$out"
        elif [ "$quiet" = 1 ]; then cat "$out" >&2
        else cat "$out"; fi
        say "redfirst: $bad of $total irreplaceable assets need attention."
        say 'A copy you have never restored from is not a copy.'
        say 'Mark it after checking: redfirst verified "<name>"'
        exit 1
    fi
    [ "$quiet" = 1 ] || printf 'redfirst: all %s assets checked within their period.\n' "$total"
    exit 0
}

# ── verified ─────────────────────────────────────────────────────────────────

cmd_verified() {
    [ $# -ge 1 ] || die 'usage: redfirst verified "<name>"'
    name=$(trim "$1")
    [ -n "$name" ] || die 'empty name'
    [ -f "$ASSETS" ] || die "no $ASSETS"
    today=$(date +%Y-%m-%d)
    # Lock, and write the replacement NEXT TO the registry rather than in $TMP:
    # mv is atomic only within one filesystem, and $TMP is often another device,
    # so the previous cp left a window where the file was half-written. Two
    # concurrent runs used to lose records and append a phantom asset.
    lock="$CONFIG_DIR/.lock"
    mkdir "$lock" 2>/dev/null || die "another redfirst is editing the registry (remove $lock if it is not)"
    _vtrap='rmdir "$lock" 2>/dev/null || true; rm -f "$ASSETS".new.* 2>/dev/null || true; cleanup'
    trap "$_vtrap" EXIT INT TERM
    trap "$_vtrap; exit 141" PIPE
    trap "$_vtrap; exit 129" HUP
    # Normalise here, in THIS process. 0.4.0 pointed this loop at a file that
    # only `due` creates, in `due`'s own temp directory, so `verified` failed on
    # every invocation, in every shell, while `due` kept advertising it in each
    # report. Caused by a global sed that matched both read loops at once.
    tr '\r' '\n' < "$ASSETS" > "$TMP/verify.norm"
    tmp="$ASSETS.new.$$"
    : > "$tmp"
    found=0
    while IFS= read -r raw || [ -n "$raw" ]; do
        line=$(clean_line "$raw")
        cur=$(trim "$(printf '%s' "$line" | cut -d'|' -f1)")
        if [ "$found" = 0 ] && [ -n "$name" ] && [ "$cur" = "$name" ]; then
            period=$(trim "$(printf '%s' "$line" | cut -d'|' -f3)")
            # Refuse rather than substitute a default. Silently writing 30 over an
            # unparseable period erased the only evidence that the line was broken
            # and turned a red `due` into a green one.
            case "$period" in
                ''|*[!0-9]*) die "period \"$period\" of asset \"$name\" is not parsed - fix the line by hand" ;;
            esac
            rest=$(printf '%s' "$line" | cut -s -d'|' -f4-)
            if [ -n "$rest" ]; then
                printf '%s | %s | %s |%s\n' "$name" "$today" "$period" "$rest" >> "$tmp"
            else
                printf '%s | %s | %s\n' "$name" "$today" "$period" >> "$tmp"
            fi
            found=1
        else
            printf '%s\n' "$line" >> "$tmp"
        fi
    done < "$TMP/verify.norm"
    [ "$found" = 1 ] || { rm -f "$tmp"; die "no asset named \"$name\" in $ASSETS"; }
    mv -f "$tmp" "$ASSETS"
    printf 'redfirst: "%s" marked as verified on %s.\n' "$name" "$today"
}

# ── init ─────────────────────────────────────────────────────────────────────

cmd_init() {
    mkdir -p "$CONFIG_DIR"
    printf 'redfirst %s\n\n' "$VERSION"
    printf 'Source masks (check that this is your project):\n'
    source_patterns | tr '\n' ' ' | sed 's/^/  /;s/$/\n/'
    n=$(list_sources | grep -c . || true)
    printf 'Files matched: %s\n' "$n"
    [ "$n" = "0" ] && printf 'Zero - set your own masks in %s, or the checks are pointless.\n' "$SOURCES"
    printf '\n'
    if [ -f "$ASSETS" ]; then
        printf '%s already exists - leaving it as it is.\n' "$ASSETS"
    else
        tpl="$(dirname "$0")/../templates/irreplaceable"
        if [ -f "$tpl" ]; then cp "$tpl" "$ASSETS"
        else printf '# name | date RESTORING was last verified | period, days\n' > "$ASSETS"; fi
        printf 'Created %s.\n\n' "$ASSETS"
        printf 'Write down what is irreplaceable. Your ~/.ssh and ~/.android are not scanned\n'
        printf 'on purpose: printing a list of paths to private keys on screen is\n'
        printf 'exactly the mistake this tool is supposed to prevent.\n'
        printf 'Irreplaceable is not the rare file but the one whose loss stops the product,\n'
        printf 'including whatever sits on a server.\n'
    fi
}

usage() {
    cat <<'EOF'
redfirst - deterministic checkpoints for AI-assisted development.

  redfirst init                 detect the project, create the config
  redfirst changed [<ref>]      what appeared and disappeared - where to start
  redfirst red "<what>" -- <cmd>   run it and record that the check FAILS
  redfirst green "<what>" -- <cmd> run it and record the move to green
  redfirst drop "<what>" -- <why>  withdraw an entry, with the reason recorded
  redfirst log                  journal: what was shown red, what is closed
  redfirst due [--quiet]        overdue restore checks
  redfirst verified "<name>"    mark an asset verified today
  redfirst wired <Symbol>       in how many files the name is in code; one is dead
  redfirst samples <pattern>    a count plus samples from start, middle and end
  redfirst counter <term...>    search for what is claimed absent

Exit codes: 0 clean, 1 something to look at, 2 could not check.
Exit 2 never means "all fine".
EOF
}

# Sourced as a library by the unit tests, which need parse_date, split3 and
# is_noise directly; a dispatcher that fires on source makes that impossible.
[ "${REDFIRST_LIB:-}" = "1" ] && return 0 2>/dev/null

[ $# -ge 1 ] || { usage; exit 0; }
cmd="$1"; shift
case "$cmd" in
    init)     cmd_init "$@" ;;
    changed)  cmd_changed "$@" ;;
    red)      _red_green red "$@" ;;
    green)    _red_green green "$@" ;;
    drop)     cmd_drop "$@" ;;
    log)      cmd_log "$@" ;;
    due)      cmd_due "$@" ;;
    verified) cmd_verified "$@" ;;
    wired)    cmd_wired "$@" ;;
    samples)  cmd_samples "$@" ;;
    counter)  cmd_counter "$@" ;;
    -h|--help|help) usage ;;
    -v|--version)   printf 'redfirst %s\n' "$VERSION" ;;
    *) die "unknown command: $cmd" ;;
esac
