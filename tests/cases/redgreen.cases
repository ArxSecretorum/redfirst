# red / green / log — правило, в честь которого инструмент назван.
# id ~ напр ~ код ~ подстрока ~ стенд ~ команда ~ происхождение
#
# До 2026-08-17 «сначала красное» жило текстом в CLAUDE.md, то есть держалось
# на добросовестности того, кого проверяют. Инструмент против непроверяемых
# утверждений стоял на непроверяемом утверждении.
#
# Теперь команду запускает он сам и сверяет исход. Здесь проверяется ровно то,
# что он отказывается верить на слово.

redgreen-red-refuses-passing ~ red   ~ 2 ~ the command succeeded && !Recorded ~ - ~ @sh sh "$RF" red "проба" -- true ~ 2026-08-17: объявить красным то, что проходит, нельзя — записывать нечего
redgreen-red-records         ~ green ~ 0 ~ Recorded RED ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'exit 1' ~ 2026-08-17: падающая команда записывается вместе с кодом возврата
redgreen-red-shows-output    ~ green ~ 0 ~ here is why it failed ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'echo "here is why it failed" >&2; exit 1' ~ 2026-08-17: человек, не читающий код, должен увидеть, ЧЕМ оно упало, а не только что упало
redgreen-green-needs-red     ~ red   ~ 2 ~ Green without a red ~ - ~ @sh sh "$RF" green "проба" -- true ~ 2026-08-17: зелёное без предшествующего красного ничего не доказывает
redgreen-green-still-red     ~ red   ~ 1 ~ Still red ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; sh "$RF" green "проба" -- sh -c 'exit 1' ~ 2026-08-17: попытка закрыть то, что всё ещё падает, в журнал не пишется
redgreen-transition          ~ green ~ 0 ~ Recorded GREEN ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; sh "$RF" green "проба" -- true ~ 2026-08-17: полный переход красное → зелёное
redgreen-empty-claim         ~ red   ~ 2 ~ empty claim ~ - ~ @sh sh "$RF" red "" -- true ~ 2026-08-17: запись без имени бесполезна тому, кто её потом читает
redgreen-needs-separator     ~ red   ~ 2 ~ you need -- ~ - ~ @sh sh "$RF" red "проба" true ~ 2026-08-17: без -- непонятно, где кончается утверждение и начинается команда
redgreen-needs-command       ~ red   ~ 2 ~ no command given ~ - ~ @sh sh "$RF" red "проба" -- ~ 2026-08-17: утверждение без команды — снова слово вместо проверки

# ── Д3: запись обязана знать, о каком коде шла речь ─────────────────────────
# Журнал писал дату, состояние, код, команду и утверждение. Через неделю
# «хук доходит до человека — красное 17.08, зелёное 17.08» не сопоставляется
# ни с одним изменением: кода за записью нет.

redgreen-records-commit  ~ green ~ 0 ~ COMMIT-IN-LEDGER ~ - ~ @sh git init -q .; git -c user.email=t@t -c user.name=t commit -q --allow-empty -m x; sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; H=$(git rev-parse HEAD); grep -qF "$H" .redfirst/ledger && echo COMMIT-IN-LEDGER ~ 2026-08-17: Д3 — в записи обязан стоять коммит на момент запуска
redgreen-outside-git     ~ green ~ 0 ~ not-a-repo && Recorded RED ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'exit 1'; cat .redfirst/ledger ~ 2026-08-17: Д3 — вне репозитория журнал обязан не падать, а сказать прямо, что кода за записью нет
redgreen-marks-dirty     ~ green ~ 0 ~ +dirty ~ - ~ @sh git init -q .; git -c user.email=t@t -c user.name=t commit -q --allow-empty -m x; printf 'x\n' > junk.kt; sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; cat .redfirst/ledger ~ 2026-08-17: коммит при грязном дереве описывает запись лишь приблизительно, и сказать об этом обязана сама запись
redgreen-own-files-clean ~ green ~ 0 ~ !+dirty ~ - ~ @sh git init -q .; git -c user.email=t@t -c user.name=t commit -q --allow-empty -m x; sh "$RF" red "первое" -- sh -c 'exit 1' >/dev/null 2>&1; sh "$RF" red "второе" -- sh -c 'exit 1' >/dev/null 2>&1; cat .redfirst/ledger ~ 2026-08-17: собственный журнал инструмента не делает дерево грязным — иначе вторая запись всегда обвиняла бы первую

# ── Д4: опечатка в формулировке не должна оставлять вечное красное ──────────
# Ключ связи красного и зелёного — точное совпадение формулировки, и это
# сделано намеренно: так нельзя закрыть одно другим. Но опечатка создаёт
# запись, которую нечем закрыть, и log показывает её открытой всегда.
#
# Отказ от записи обязан быть громким: молчаливое удаление хуже неверной
# записи. Исчезнувшая запись не оставляет и следа о том, что её отзывали.

drop-needs-separator ~ red   ~ 2 ~ you need -- ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; sh "$RF" drop "проба" опечатка ~ 2026-08-17: Д4 — без -- непонятно, где кончается формулировка и начинается причина
drop-needs-reason    ~ red   ~ 2 ~ silent deletion ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; sh "$RF" drop "проба" -- ~ 2026-08-17: Д4 — отказ без причины и есть молчаливое удаление, только через другую дверь
drop-refuses-unknown ~ red   ~ 2 ~ no open red with this wording ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; sh "$RF" drop "не та формулировка" -- ошибся ~ 2026-08-17: Д4 — отозвать можно только то, что открыто; иначе drop станет способом писать в журнал что угодно
drop-refuses-closed  ~ red   ~ 2 ~ no open red with this wording ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; sh "$RF" green "проба" -- true >/dev/null 2>&1; sh "$RF" drop "проба" -- передумал ~ 2026-08-17: Д4 — закрытое зелёным отзывать нечего, и переписывать историю задним числом нельзя
drop-closes-open     ~ green ~ 0 ~ !OPEN ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; sh "$RF" drop "проба" -- опечатка в формулировке >/dev/null 2>&1; sh "$RF" log ~ 2026-08-17: Д4 — отозванное перестаёт числиться открытым, иначе вечное красное так и остаётся вечным
drop-keeps-record    ~ green ~ 0 ~ red && drop && dropped: ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; sh "$RF" drop "проба" -- опечатка в формулировке >/dev/null 2>&1; sh "$RF" log ~ 2026-08-17: Д4 — в журнале остаются обе записи и причина отказа: удаления не происходит
drop-not-a-green     ~ green ~ 0 ~ !closed green ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; sh "$RF" drop "проба" -- опечатка в формулировке >/dev/null 2>&1; sh "$RF" log ~ 2026-08-17: Д4 — отозванное не должно засчитываться закрытым зелёным: это разные исходы, и путать их — снова выдавать «не знаю» за «в порядке»
drop-then-green-refused ~ red ~ 2 ~ Green without a red ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; sh "$RF" drop "проба" -- опечатка >/dev/null 2>&1; sh "$RF" green "проба" -- true ~ 2026-08-17: Д4 — после отказа зелёное снова требует красного; иначе drop станет обходом главного правила

# ── журнал ──────────────────────────────────────────────────────────────────
log-empty                    ~ red   ~ 2 ~ check journal is empty ~ - ~ @sh sh "$RF" log ~ 2026-08-17: пустой журнал — это отказ отвечать, а не «всё закрыто»
log-open                     ~ red   ~ 1 ~ OPEN ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; sh "$RF" log ~ 2026-08-17: показанное красным и не закрытое обязано быть названо
log-closed                   ~ green ~ 0 ~ closed green ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; sh "$RF" green "проба" -- true >/dev/null 2>&1; sh "$RF" log ~ 2026-08-17: закрытый журнал даёт ноль. Ловушка set -e: цикл возвращал 1, log печатал журнал и молча выходил единицей
log-shows-commit             ~ green ~ 0 ~ COMMIT-IN-LOG ~ - ~ @sh git init -q .; git -c user.email=t@t -c user.name=t commit -q --allow-empty -m x; sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; S=$(git rev-parse --short=7 HEAD); sh "$RF" log | grep -qF "$S" && echo COMMIT-IN-LOG ~ 2026-08-17: Д3 — журнал человек читает через log, и коммит обязан быть виден именно там
log-keeps-both-entries       ~ green ~ 0 ~ red && green ~ - ~ @sh sh "$RF" red "проба" -- sh -c 'exit 1' >/dev/null 2>&1; sh "$RF" green "проба" -- true >/dev/null 2>&1; sh "$RF" log ~ 2026-08-17: журнал накапливает, а не заменяет: виден и переход, и то, с чего начали
