# samples, counter, verified, init — остальные команды.
# id ~ напр ~ код ~ подстрока ~ стенд ~ команда ~ происхождение

# ── samples: число обязано приходить с образцами того, что посчитано ────────
samples-shows-samples  ~ green ~ 0 ~ Samples from the start ~ @kotlin ~ samples 'fun '        ~ 2026-08-16: 26 против 10 — число без образцов обмануло вывод
samples-counts         ~ green ~ 0 ~ matches              ~ @kotlin ~ samples 'class '      ~ 2026-08-16: базовый счёт
samples-bad-regex      ~ red   ~ 2 ~ not a valid regular  ~ @kotlin ~ samples 'Foo['        ~ 2026-08-17: битая регулярка выдавалась за «0 совпадений» с чистым кодом
samples-no-match       ~ red   ~ 1 ~ 0 matches            ~ @kotlin ~ samples 'zzzNoSuch'   ~ 2026-08-17: отсутствие совпадений — код 1, не 0

# ── counter: утверждение об отсутствии требует поиска присутствия ───────────
counter-found          ~ red   ~ 1 ~ as worded, is false  ~ @kotlin ~ counter Helper        ~ 2026-08-16: найденное опровергает утверждение об отсутствии
counter-absent         ~ green ~ 0 ~ Not found            ~ @kotlin ~ counter zzzNoSuchTerm ~ 2026-08-16: подтверждённое отсутствие
counter-sees-tests     ~ red   ~ 1 ~ as worded, is false  ~ @kotlin ~ counter OnlyTestUser  ~ 2026-08-17: секрет в фикстуре — всё ещё секрет, тесты сканируются
counter-shows-root     ~ green ~ 0 ~ Scanned from   ~ @kotlin ~ counter zzzNoSuchTerm ~ 2026-08-17: отчёт называет корень

# ── verified: правка реестра ────────────────────────────────────────────────
verified-marks         ~ green ~ 0 ~ marked as verified ~ reg:Ключ | never | 90        ~ verified Ключ    ~ 2026-08-17: команда не работала вообще — читала чужой временный файл
verified-unknown-name  ~ red   ~ 2 ~ no                   ~ reg:Ключ | never | 90        ~ verified Чужой   ~ 2026-08-16: несуществующее имя
verified-empty-name    ~ red   ~ 2 ~ empty name          ~ reg:Ключ | never | 90        ~ verified ''      ~ 2026-08-17: пустое имя рапортовало об успехе
verified-no-registry   ~ red   ~ 2 ~ no                   ~ -                            ~ verified Ключ    ~ 2026-08-17: реестра нет
verified-bad-period    ~ red   ~ 2 ~ is not parsed         ~ reg:Ключ | never | тридцать  ~ verified Ключ    ~ 2026-08-17: молча подставлял 30 и стирал улику порчи

# ── init ────────────────────────────────────────────────────────────────────
init-creates-registry  ~ green ~ 0 ~ Created             ~ @kotlin ~ init                  ~ 2026-08-17: базовая установка конфига
init-no-key-scan       ~ green ~ 0 ~ !id_ed25519          ~ @kotlin ~ init                 ~ 2026-08-16: init печатал на экран пути к приватным ключам
init-reports-masks     ~ green ~ 0 ~ Source masks     ~ @kotlin ~ init                 ~ 2026-08-17: определение обязано показывать, что нашло

# ── общий контракт ──────────────────────────────────────────────────────────
usage-no-args          ~ green ~ 0 ~ redfirst init        ~ -       ~ NOARGS               ~ 2026-08-17: без аргументов — справка, код 0
unknown-command        ~ red   ~ 2 ~ unknown command      ~ -       ~ нетакой               ~ 2026-08-17: неизвестная команда — код 2
version-flag           ~ green ~ 0 ~ redfirst             ~ -       ~ --version             ~ 2026-08-17: версия печатается

# ── verified: правка реестра, продолжение 2026-08-17 ────────────────────────
verified-keeps-fourth-field ~ green ~ 0 ~ out:заметка && !never ~ - ~ @sh mkdir -p .redfirst; printf 'K | never | 30 | заметка\n' > .redfirst/irreplaceable; sh "$RF" verified K >/dev/null; cat .redfirst/irreplaceable ~ 2026-08-17: четвёртое поле — свободная заметка владельца. Переписать строку и потерять её значит стереть то, ради чего человек её писал
verified-releases-lock      ~ green ~ 0 ~ marked as verified ~ - ~ @sh mkdir -p .redfirst; printf 'K | never | 30\n' > .redfirst/irreplaceable; sh "$RF" verified K >/dev/null 2>&1; sh "$RF" verified K ~ 2026-08-17: замок снимается после успеха. Оставленный замок блокирует правку реестра навсегда, а снимать его руками никто не догадается

# ── свои маски в .redfirst/sources ──────────────────────────────────────────
sources-custom-masks        ~ red   ~ 2 ~ no file matched the source masks && *.java && !ALIVE ~ @kotlin ~ @sh mkdir -p .redfirst; printf '*.java\n' > .redfirst/sources; sh "$RF" wired Helper ~ 2026-08-17: свои маски обязаны действовать. Если бы автоопределение молча побеждало, владелец получил бы вердикт по файлам, которые не собирался проверять
