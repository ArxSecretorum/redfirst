# due — реестр невосстановимых активов.
# id ~ напр ~ код ~ подстрока ~ стенд ~ команда ~ происхождение
#
# Направление: red — инструмент обязан поднять тревогу; green — обязан молчать.

due-never              ~ red   ~ 1 ~ NEVER been checked           ~ reg:Ключ | never | 90            ~ due          ~ 2026-08-16: never обязан считаться просрочкой
due-never-capital      ~ red   ~ 1 ~ NEVER been checked           ~ reg:Ключ | Never | 90            ~ due          ~ 2026-08-16: Never с большой буквы проходил мимо
due-overdue            ~ red   ~ 1 ~ days ago         ~ reg:Ключ | 2020-01-01 | 30       ~ due          ~ 2026-08-16: просрочка по периоду
due-in-time            ~ green ~ 0 ~ within their period  ~ reg:Ключ | 2026-08-17 | 30       ~ due          ~ 2026-08-16: свежая дата не должна тревожить
due-bad-date           ~ red   ~ 1 ~ not parsed      ~ reg:Ключ | 30 дней | 30          ~ due          ~ 2026-08-16: неразобранная дата = просрочка, не норма
due-impossible-date    ~ red   ~ 1 ~ not parsed      ~ reg:Ключ | 2026-02-30 | 30       ~ due          ~ 2026-08-16: 30 февраля принималось как валидное
due-future-date        ~ red   ~ 1 ~ is in the future         ~ reg:Ключ | 2099-01-01 | 30       ~ due          ~ 2026-08-16: опечатка в годе объявляла актив вечно свежим
due-nonnumeric-period  ~ red   ~ 1 ~ is not a number          ~ reg:Ключ | 2026-08-17 | тридцать ~ due          ~ 2026-08-16: нечисловой период отключал проверку
due-zero-period        ~ red   ~ 1 ~ greater than zero       ~ reg:Ключ | 2026-08-17 | 0        ~ due          ~ 2026-08-16: нулевой период
due-leading-separator  ~ red   ~ 1 ~ line with no name         ~ reg:| Ключ | 2026-08-17 | 30     ~ due          ~ 2026-08-16: ведущий разделитель прятал актив целиком
due-extra-field        ~ green ~ 0 ~ within their period  ~ reg:Ключ | 2026-08-17 | 30 | заметка ~ due      ~ 2026-08-16: четвёртое поле не должно ломать разбор
due-empty-registry     ~ red   ~ 1 ~ is empty              ~ reg:# только комментарий         ~ due          ~ 2026-08-17: пустой реестр — состояние сразу после установки
due-empty-quiet        ~ red   ~ 1 ~ is empty              ~ reg:# только комментарий         ~ due --quiet  ~ 2026-08-17: --quiet глушил и это, хук молчал зря
due-missing-registry   ~ red   ~ 2 ~ Run: redfirst init         ~ -                                ~ due          ~ 2026-08-17: отсутствие реестра = код 2, не тишина
due-missing-quiet      ~ red   ~ 2 ~ Run: redfirst init         ~ -                                ~ due --quiet  ~ 2026-08-17: --quiet глушил отсутствие реестра целиком
due-indented-hash-name ~ red   ~ 1 ~ NEVER been checked           ~ reg: Ключ #1 | never | 90        ~ due          ~ 2026-08-17: отступ плюс решётка в имени прятали актив
due-comment-ignored    ~ green ~ 0 ~ within their period  ~ reg:# комментарий\nКлюч | 2026-08-17 | 30 ~ due ~ 2026-08-16: комментарии пропускаются
due-august-date        ~ green ~ 0 ~ within their period  ~ reg:Ключ | 2026-08-01 | 90       ~ due          ~ 2026-08-16: $((10#08)) — башизм, в dash падение
due-september-date     ~ green ~ 0 ~ within their period  ~ reg:Ключ | 2025-09-01 | 9999     ~ due          ~ 2026-08-16: тот же башизм на девятом месяце
due-leap-valid         ~ green ~ 0 ~ within their period  ~ reg:Ключ | 2024-02-29 | 9999     ~ due          ~ 2026-08-17: 2024 високосный, дата существует
due-leap-invalid       ~ red   ~ 1 ~ not parsed      ~ reg:Ключ | 2026-02-29 | 30       ~ due          ~ 2026-08-17: 2026 не високосный
due-crlf-registry      ~ red   ~ 1 ~ NEVER been checked           ~ reg:Ключ | never | 30\r          ~ due          ~ 2026-08-16: CRLF из Windows-редактора отключал актив
due-two-assets         ~ red   ~ 1 ~ 1 of 2            ~ reg:Живой | 2026-08-17 | 30\nМёртвый | never | 30 ~ due ~ 2026-08-17: счёт по обоим
due-quiet-goes-to-stderr ~ red ~ 1 ~ err:NEVER been checked      ~ reg:Ключ | never | 90 ~ due --quiet ~ 2026-08-17: хук показывает stderr при ненулевом коде; вывод в stdout не доходил никогда
due-quiet-not-stdout   ~ red   ~ 1 ~ !STDOUTMARK      ~ reg:Ключ | never | 90 ~ due --quiet ~ 2026-08-17: контроль к предыдущему
due-plain-goes-stdout  ~ green ~ 0 ~ out:within their period       ~ reg:Ключ | 2026-08-17 | 30 ~ due ~ 2026-08-17: ручной вызов печатает в stdout, как обычная команда
