#!/bin/sh
# Regression suite for redfirst. POSIX sh, no dependencies — the tool promises
# none, so its tests may not require any either.
#
# What matters here is not pass/fail but DIRECTION. A `red` case asserts the
# tool raises the alarm; failing one means the tool missed a defect, which is
# the only class of failure that is actually dangerous. A `green` case asserts
# it stays quiet; failing one is noise — annoying, never harmful. They are
# counted separately, because "3 failed" tells you nothing and "1 blocker,
# 2 noise" tells you everything.
set -u

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$HERE/.." && pwd)
TOOL="$ROOT/bin/redfirst"
CASES="$HERE/cases"
FIXTURES="$HERE/fixtures"
UNIT="$HERE/unit"

[ -f "$TOOL" ] || { echo "не найден $TOOL" >&2; exit 3; }

WORK=$(mktemp -d "${TMPDIR:-/tmp}/rf-tests.XXXXXX") || exit 3
# chmod перед удалением: случай на ошибку поиска снимает права с каталога, и
# без этого `rm -rf` спотыкается о собственный стенд. На Pi после первого же
# прогона оставался каталог с правами 000 — набор, который сорит в /tmp на
# целевой машине, к доверию не располагает.
trap 'chmod -R u+rwX "$WORK" 2>/dev/null; rm -rf "$WORK"' EXIT INT TERM

# Shells under test. dash is the target platform's /bin/sh; a bug invisible in
# bash killed `due` on every August date before this file existed.
if [ -n "${SHELLS:-}" ]; then
    :
else
SHELLS=""
for sh_candidate in dash bash; do
    command -v "$sh_candidate" >/dev/null 2>&1 && SHELLS="$SHELLS $sh_candidate"
done
[ -n "$SHELLS" ] && SHELLS=${SHELLS# } || SHELLS="sh"
fi
case " $SHELLS " in
    *" dash "*) ;;
    *) printf 'ПРЕДУПРЕЖДЕНИЕ: dash не установлен, переносимость не проверяется\n' >&2 ;;
esac

blockers=0; noise=0; diffs=0; passed=0; total=0; known=0; fixed=0; skipped=0
blocker_list=""; noise_list=""; diff_list=""; known_list=""; fixed_list=""
skip_list=""

note() { printf '%s\n' "$*"; }

# ── fixture preparation ──────────────────────────────────────────────────────
# `-` empty project, `@name` a copy from fixtures/, `reg:LINE\nLINE` a registry,
# `setup:PATH` a script that builds the box itself. The last one exists because
# a multi-line literal, a CP1251 file or a path with a space cannot be written
# on one `~`-separated line — and those are precisely where the classifier
# breaks.
prepare() {
    spec="$1"; dest="$2"
    mkdir -p "$dest"
    case "$spec" in
        -|'') : ;;
        @*)   src="$FIXTURES/${spec#@}"
              [ -d "$src" ] || { echo "нет стенда $src" >&2; return 1; }
              cp -R "$src/." "$dest/" 2>/dev/null || return 1 ;;
        reg:*)
              mkdir -p "$dest/.redfirst"
              printf '%b\n' "${spec#reg:}" > "$dest/.redfirst/irreplaceable" ;;
        setup:*)
              # Exit 77 from setup.sh means "the condition could not be created
              # here" — an unreadable file cannot be made under Git Bash on
              # Windows, and chmod 000 silently does nothing. The script must
              # VERIFY the fault took and say 77 itself; guessing by platform
              # name would be the same unchecked assumption the tool exists to
              # fight. The reason it prints becomes the report line.
              [ -f "${spec#setup:}" ] || { echo "нет ${spec#setup:}" >&2; return 1; }
              ( cd "$dest" && sh "${spec#setup:}" ) > "$WORK/setup.out" 2>&1
              _prep=$?
              [ "$_prep" = 77 ] && return 77
              [ "$_prep" = 0 ] || return 1 ;;
        *)    echo "неизвестный вид стенда: $spec" >&2; return 1 ;;
    esac
}

# ── one case in one shell ────────────────────────────────────────────────────
# Prints "ok" or a human-readable reason.
# Read-only commands share one prepared copy of each fixture instead of getting
# their own: copying the tree per case was the bulk of the runtime, and
# wired/samples/counter never write anything.
readonly_cmd() {
    case "$1" in
        wired*|samples*|counter*|--version*|NOARGS) return 0 ;;
        *) return 1 ;;
    esac
}

shared_box() {
    _key=$(printf '%s' "$1" | tr -c 'A-Za-z0-9' '_')
    _box="$WORK/shared.$_key"
    [ -d "$_box" ] && { printf '%s' "$_box"; return 0; }
    mkdir -p "$_box"
    prepare "$1" "$_box" >/dev/null 2>&1
    _sbc=$?
    [ "$_sbc" = 0 ] || { rm -rf "$_box"; return "$_sbc"; }
    printf '%s' "$_box"
}

# The reason a skip happened is the first line the setup script printed.
skip_reason() {
    _r=$(head -n 1 "$WORK/setup.out" 2>/dev/null)
    [ -n "$_r" ] || _r='условие не воспроизводится на этой платформе'
    printf 'SKIP %s' "$_r"
}

run_one() {
    _sh="$1"; _dir="$2"; _code="$3"; _needle="$4"; _fixture="$5"; _cmd="$6"
    if readonly_cmd "$_cmd"; then
        box=$(shared_box "$_fixture")
        _bc=$?
        [ "$_bc" = 77 ] && { skip_reason; return 1; }
        [ "$_bc" = 0 ] || { printf 'стенд не собрался'; return 1; }
    else
        box="$WORK/box.$$"
        rm -rf "$box"; mkdir -p "$box"
        prepare "$_fixture" "$box"
        _bc=$?
        [ "$_bc" = 77 ] && { skip_reason; return 1; }
        [ "$_bc" = 0 ] || { printf 'стенд не собрался'; return 1; }
    fi

    # Streams are captured separately. Merging them hid the single property the
    # hook depends on: `due --quiet` must write to STDERR, because a SessionStart
    # hook shows stdout only on exit 0 and stderr only on any other code. With
    # 2>&1 the suite could not tell a working hook from a silent one.
    _o="$WORK/o.$$"; _e="$WORK/e.$$"
    case "$_cmd" in
        NOARGS)
            ( cd "$box" && "$_sh" "$TOOL" ) >"$_o" 2>"$_e" ;;
        # `@sh <код>` runs arbitrary shell in the box. The installer is not a
        # subcommand, and idempotence can only be shown by running twice —
        # neither fits "arguments after redfirst".
        @sh\ *)
            ( cd "$box" && RF="$TOOL" INSTALL="$ROOT/install.sh" RFROOT="$ROOT" \
              "$_sh" -c "${_cmd#@sh }" ) >"$_o" 2>"$_e" ;;
        *)
            ( cd "$box" && eval "$_sh \"\$TOOL\" $_cmd" ) >"$_o" 2>"$_e" ;;
    esac
    rc=$?

    if [ "$_code" != "*" ] && [ "$rc" != "$_code" ]; then
        printf 'код %s, ожидался %s' "$rc" "$_code"; return 1
    fi
    # Assertions are separated by `&&`. One report has to satisfy several claims
    # at once — a bucket number AND the arithmetic — and re-running the tool for
    # each claim costs more than the claim is worth.
    _rest_n=$_needle
    while :; do
        case $_rest_n in
            *"&&"*) _one=${_rest_n%%&&*}; _rest_n=${_rest_n#*&&} ;;
            *)      _one=$_rest_n;        _rest_n="" ;;
        esac
        trim_set "$_one"
        [ -z "$_tv" ] || check_needle "$_tv" "$_o" "$_e" || return 1
        [ -n "$_rest_n" ] || break
    done
    printf 'ok'
}

# Splitting with cut+sed cost twelve forks per line and twenty seconds per run
# on sixty lines — the same defect the tool itself had in `due`, reproduced in
# its test harness. Parameter expansion does it with none. The result lands in a
# variable instead of on stdout, because reading a helper's result through
# `$(…)` is itself a fork, and there are six fields per case line — the same
# mistake, one level smaller. Every run parses every case even when ONLY selects
# three of them, so this was paid on the self-check too: 25 с → 8 с.
_tv=""
trim_set() {
    _tv=$1
    while :; do case $_tv in [\ \	]*) _tv=${_tv#?} ;; *) break ;; esac; done
    while :; do case $_tv in *[\ \	]) _tv=${_tv%?} ;; *) break ;; esac; done
}

# $1 — имена полей через пробел, $2 — строка. Табличный случай и `expect`
# каталожного различаются одним полем, и это единственное различие.
split_into() {
    _names=$1; _rest=$2
    for _name in $_names; do
        case $_rest in
            *~*) _val=${_rest%%~*}; _rest=${_rest#*~} ;;
            *)   _val=$_rest;       _rest="" ;;
        esac
        trim_set "$_val"
        eval "$_name=\$_tv"
    done
}

# ── numbers out of a wired report ────────────────────────────────────────────
# The bucket breakdown IS the product: a count a non-reader can judge. Checking
# it by substring let a report with "всего совпадений 4" and zero in every
# bucket pass unnoticed — the arithmetic did not add up and nothing looked.
# Keys are latin: they are the tool's own internal bucket names. The labels are
# Russian because the report is.
_num=""
report_num() {
    case $1 in
        files) _lbl='файлов с упоминанием' ;;
        code)  _lbl='из них в коде' ;;
        text)  _lbl='только вне кода' ;;
        hits)  _lbl='упоминаний в коде' ;;
        *)     _num=""; return 1 ;;
    esac
    # Anchored on the report block, not on the label alone: prose below the
    # block mentioned the same words and the parser read a number out of a
    # sentence. Bucket lines are the only ones indented by two spaces.
    _num=""
    while IFS= read -r _l; do
        case $_l in "  $_lbl"*) _num=${_l##* } ;; esac
    done < "$2"
    [ -n "$_num" ] || return 1
    case $_num in ''|*[!0-9]*) _num=""; return 1 ;; esac
    return 0
}

# ── one assertion ────────────────────────────────────────────────────────────
# Prints the reason and returns 1 when it does not hold; that print is the
# caller's return value, so no subshell is needed to carry it back.
check_needle() {
    _n=$1; _o_f=$2; _e_f=$3
    case "$_n" in
        -|'') return 0 ;;
        sum)
            for _k in files code text; do
                if ! report_num "$_k" "$_o_f"; then
                    printf 'в отчёте нет корзины %s (начало вывода: %s)' "$_k" \
                           "$(head -c 70 "$_o_f" 2>/dev/null | tr '\n' ' ')"
                    return 1
                fi
                eval "_v_$_k=\$_num"
            done
            _s=$((_v_code + _v_text))
            if [ "$_s" != "$_v_files" ]; then
                printf 'арифметика не сходится: файлов %s, по корзинам %s (%s+%s)' \
                       "$_v_files" "$_s" "$_v_code" "$_v_text"
                return 1
            fi ;;
        n:*)
            _kv=${_n#n:}; _k=${_kv%%=*}; _want=${_kv#*=}
            if ! report_num "$_k" "$_o_f"; then
                printf 'в отчёте нет корзины %s (начало вывода: %s)' "$_k" \
                       "$(head -c 70 "$_o_f" 2>/dev/null | tr '\n' ' ')"
                return 1
            fi
            if [ "$_num" != "$_want" ]; then
                printf 'корзина %s = %s, ожидалось %s' "$_k" "$_num" "$_want"; return 1
            fi ;;
        err:*)
            if ! grep -qF -- "${_n#err:}" "$_e_f" 2>/dev/null; then
                printf 'нет «%s» в STDERR (там: %s)' "${_n#err:}" \
                       "$(head -c 60 "$_e_f" 2>/dev/null | tr '\n' ' ')"; return 1
            fi ;;
        out:*)
            if ! grep -qF -- "${_n#out:}" "$_o_f" 2>/dev/null; then
                printf 'нет «%s» в STDOUT' "${_n#out:}"; return 1
            fi ;;
        !*)
            if grep -qF -- "${_n#!}" "$_o_f" "$_e_f" 2>/dev/null; then
                printf 'нашлось запрещённое «%s»' "${_n#!}"; return 1
            fi ;;
        *)
            if ! grep -qF -- "$_n" "$_o_f" "$_e_f" 2>/dev/null; then
                printf 'нет строки «%s»' "$_n"; return 1
            fi ;;
    esac
    return 0
}

# ── one case, every shell, counted ───────────────────────────────────────────
# `red?` / `green?` mean the same direction plus "does not hold today, the
# defect is open". Cases for the three publication blockers are written BEFORE
# the fix; without the mark the suite goes permanently red and at that moment
# stops telling a known defect from a new regression — which is the whole of
# what a regression suite does.
#
# The mark must never become a way to hide red, so: open defects are named in
# every run, the exit code is never 0 while one is open, and a marked case that
# PASSES is a hard failure demanding the mark be removed. A stale mark is worse
# than the defect — it silences a check that already works, permanently.
tally() {
    _id=$1; _dr=$2; _cd=$3; _nd=$4; _fx=$5; _cm=$6
    _known=0
    case $_dr in *\?) _known=1; _dr=${_dr%\?} ;; esac
    first=""; verdicts=""
    for one in $SHELLS; do
        total=$((total + 1))
        why=$(run_one "$one" "$_dr" "$_cd" "$_nd" "$_fx" "$_cm")
        # A check that did not run is not a check that passed. The tool has
        # three outcomes for exactly this reason; the suite needed the same one.
        case $why in SKIP*)
            skipped=$((skipped + 1))
            skip_list="$skip_list
  $_id ($one): ${why#SKIP }"
            verdicts="$verdicts $one=skip"
            [ -z "$first" ] && first="$why"
            continue ;;
        esac
        if [ "$_known" = 1 ]; then
            if [ "$why" = "ok" ]; then
                fixed=$((fixed + 1))
                fixed_list="$fixed_list
  $_id ($one): проходит — снимите пометку «$_dr?» в файле случая"
            else
                known=$((known + 1))
                known_list="$known_list
  $_id ($one): $why"
            fi
        elif [ "$why" = "ok" ]; then
            passed=$((passed + 1))
        elif [ "$_dr" = "red" ]; then
            blockers=$((blockers + 1))
            blocker_list="$blocker_list
  $_id ($one): $why"
        else
            noise=$((noise + 1))
            noise_list="$noise_list
  $_id ($one): $why"
        fi
        verdicts="$verdicts $one=$why"
        [ -z "$first" ] && first="$why"
        if [ "$why" != "$first" ]; then
            diffs=$((diffs + 1))
            diff_list="$diff_list
  $_id: оболочки разошлись —$verdicts"
        fi
    done
}

# ── table cases ──────────────────────────────────────────────────────────────
run_table() {
    for file in "$CASES"/*.cases; do
        [ -f "$file" ] || continue
        while IFS= read -r line || [ -n "$line" ]; do
            case $line in ''|\#*) continue ;; esac
            split_into 'id dir code needle fixture cmd' "$line"
            [ -n "$id" ] && [ -n "$cmd" ] || continue
            case "$id" in ${ONLY:-*}) ;; *) continue ;; esac
            tally "$id" "$dir" "$code" "$needle" "$fixture" "$cmd"
        done < "$file"
    done
}

# ── directory cases ──────────────────────────────────────────────────────────
# `cases/<id>/setup.sh` builds the box; `cases/<id>/expect` holds the same
# fields minus the fixture, since the fixture is the script. The id is the
# directory name — one place, not two.
run_dirs() {
    for case_dir in "$CASES"/*/; do
        [ -d "$case_dir" ] || continue
        cdir=${case_dir%/}; cid=${cdir##*/}
        case "$cid" in ${ONLY:-*}) ;; *) continue ;; esac
        if [ ! -f "$cdir/setup.sh" ] || [ ! -f "$cdir/expect" ]; then
            printf 'случай %s неполон: нужны setup.sh и expect\n' "$cid" >&2
            continue
        fi
        eline=""
        while IFS= read -r l || [ -n "$l" ]; do
            case $l in ''|\#*) continue ;; esac
            eline=$l; break
        done < "$cdir/expect"
        if [ -z "$eline" ]; then
            printf 'случай %s: expect пуст\n' "$cid" >&2; continue
        fi
        split_into 'dir code needle cmd' "$eline"
        if [ -z "$cmd" ]; then
            printf 'случай %s: в expect нет команды\n' "$cid" >&2; continue
        fi
        tally "$cid" "$dir" "$code" "$needle" "setup:$cdir/setup.sh" "$cmd"
    done
}

# ── unit tests ───────────────────────────────────────────────────────────────
run_unit() {
    for file in "$UNIT"/*.sh; do
        [ -f "$file" ] || continue
        name=$(basename "$file" .sh)
        for one in $SHELLS; do
            total=$((total + 1))
            if out=$(REDFIRST_LIB=1 TOOL="$TOOL" "$one" "$file" 2>&1); then
                passed=$((passed + 1))
            else
                blockers=$((blockers + 1))
                blocker_list="$blocker_list
  unit/$name ($one): $(printf '%s' "$out" | head -n 3 | tr '\n' ' ')"
            fi
        done
    done
}

# ── self-check ───────────────────────────────────────────────────────────────
# Breaks the tool on purpose and demands the suite notices. A suite that stays
# green on a broken tool proves nothing.
self_check() {
    note 'redfirst tests: самопроверка — ломаю инструмент и жду красного'
    note ''
    bad=0
    for pair in 'dates:due-*date*' 'noise:wired-only-in-test' \
                'single:wired-dead-*' 'quiet:due-quiet-*' \
                'strings:wired-strings-js' 'redgreen:redgreen-green-needs-red'; do
        point=${pair%%:*}; pattern=${pair#*:}
        # `sh "$0"`, не `"$0"`: исполняемый бит не переживает авторство под
        # Windows, из git всё приходит с правами 644, и на Linux прямой вызов
        # даёт Permission denied. Самопроверка при этом рапортовала ПРОВАЛ по
        # всем пяти точкам — механизм, ради которого набору вообще можно
        # доверять, не работал на целевой платформе ни разу и обвинял в этом
        # инструмент.
        out=$(REDFIRST_SELFTEST=1 REDFIRST_BREAK="$point" ONLY="$pattern" \
              SHELLS=dash sh "$0" --plain 2>&1)
        got=$(printf '%s' "$out" | sed -n 's/^BLOCKERS=//p')
        [ -n "$got" ] || got=0
        if [ "$got" -gt 0 ]; then
            printf '  %-7s сломан → %s покраснели (%s блокеров)  ok\n' "$point" "$pattern" "$got"
        else
            printf '  %-7s сломан → %s ОСТАЛИСЬ ЗЕЛЁНЫМИ  ПРОВАЛ\n' "$point" "$pattern"
            bad=$((bad + 1))
        fi
    done
    note ''
    if [ "$bad" -gt 0 ]; then
        note "Самопроверка провалена по $bad из 6 точек. Набору доверять нельзя."
        exit 3
    fi
    note 'Самопроверка пройдена: набор ловит поломку по каждой из шести точек.'
    exit 0
}

case "${1:-}" in
    --self-check) self_check ;;
    --plain)      PLAIN=1 ;;
    '')           PLAIN=0 ;;
    *)            echo "usage: run [--self-check]" >&2; exit 3 ;;
esac

run_table
run_dirs
[ -z "${ONLY:-}" ] && run_unit

if [ "${PLAIN:-0}" = "1" ]; then
    printf 'BLOCKERS=%s\n' "$blockers"
    exit 0
fi

note ""
note "redfirst tests: оболочки:$SHELLS"
note ""
printf '  БЛОКЕРЫ (инструмент прозевал дефект)   %s\n' "$blockers"
printf '  ШУМ (заругался зря)                    %s\n' "$noise"
printf '  РАСХОЖДЕНИЯ ОБОЛОЧЕК                   %s\n' "$diffs"
printf '  ИЗВЕСТНЫЕ ОТКРЫТЫЕ ДЕФЕКТЫ             %s\n' "$known"
printf '  НЕ ПРОВЕРЕНО (условие не создалось)    %s\n' "$skipped"
[ "$fixed" -gt 0 ] && printf '  ПОЧИНЕНО, пометка устарела             %s\n' "$fixed"
printf '  пройдено                               %s из %s\n' "$passed" "$total"
[ -n "$blocker_list" ] && { note ""; note "БЛОКЕРЫ:$blocker_list"; }
[ -n "$noise_list" ]   && { note ""; note "ШУМ:$noise_list"; }
[ -n "$diff_list" ]    && { note ""; note "РАСХОЖДЕНИЯ:$diff_list"; }
[ -n "$known_list" ]   && { note ""; note "ОТКРЫТЫЕ ДЕФЕКТЫ (ожидаемо не проходят):$known_list"; }
[ -n "$fixed_list" ]   && { note ""; note "ПОМЕТКА УСТАРЕЛА:$fixed_list"; }
[ -n "$skip_list" ]    && { note ""; note "НЕ ПРОВЕРЕНО:$skip_list"; }
note ""

[ "$fixed" -gt 0 ] && {
    note 'Случай с пометкой «открыт» проходит. Пока пометка не снята, эта проверка'
    note 'ничего не сторожит: она будет молчать и когда дефект вернётся.'
    exit 2
}
[ "$blockers" -gt 0 ] || [ "$diffs" -gt 0 ] && exit 2
[ "$known" -gt 0 ] && {
    note "Регрессий нет. Открытых дефектов: $known — они перечислены выше и ждут починки."
    exit 1
}
[ "$noise" -gt 0 ] && exit 1
# The word «Чисто» is not available when something did not run. Exit code
# answers "did anything break"; this line answers "was everything checked".
# Same precedent as the missing-dash warning: an unavailable dimension is loud
# and does not change the code.
if [ "$skipped" -gt 0 ]; then
    note "Ничего не сломано, но $skipped проверок не выполнено — они перечислены выше."
    note "На этой платформе их условие не создаётся. Полным набор бывает только там, где создаётся."
    exit 0
fi
note "Чисто. Прогоните ещё $0 --self-check — набор без самопроверки ничего не доказывает."
exit 0
