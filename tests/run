#!/bin/sh
# Regression suite for redfirst. POSIX sh, no dependencies — the tool promises
# none, so its tests may not require any either.
#
# What matters here is not pass/fail but DIRECTION. A `red` case asserts the
# tool raises the alarm; failing one means the tool missed a defect, which is
# the only class of failure that is actually dangerous. A `green` case asserts
# it stays quiet; failing one is noise — annoying, never harmful. They are
# counted separately, because "3 failed" tells you nothing and "1 blocker,
# 2 noise" tells you everything.
set -u

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$HERE/.." && pwd)
TOOL="$ROOT/bin/redfirst"
CASES="$HERE/cases"
FIXTURES="$HERE/fixtures"
UNIT="$HERE/unit"

[ -f "$TOOL" ] || { echo "not found: $TOOL" >&2; exit 3; }

WORK=$(mktemp -d "${TMPDIR:-/tmp}/rf-tests.XXXXXX") || exit 3
# chmod before removal: the search-error case strips permissions off a
# directory, and without it `rm -rf` trips over its own fixture. On the Pi a
# directory with mode 000 survived the very first run — a suite that litters
# /tmp on the target machine does not inspire trust.
trap 'chmod -R u+rwX "$WORK" 2>/dev/null; rm -rf "$WORK"' EXIT INT TERM

# Shells under test. dash is the target platform's /bin/sh; a bug invisible in
# bash killed `due` on every August date before this file existed.
if [ -n "${SHELLS:-}" ]; then
    :
else
SHELLS=""
for sh_candidate in dash bash; do
    command -v "$sh_candidate" >/dev/null 2>&1 && SHELLS="$SHELLS $sh_candidate"
done
[ -n "$SHELLS" ] && SHELLS=${SHELLS# } || SHELLS="sh"
fi
case " $SHELLS " in
    *" dash "*) ;;
    *) printf 'WARNING: dash is not installed, portability is not checked\n' >&2 ;;
esac

blockers=0; noise=0; diffs=0; passed=0; total=0; known=0; fixed=0; skipped=0
blocker_list=""; noise_list=""; diff_list=""; known_list=""; fixed_list=""
skip_list=""

note() { printf '%s\n' "$*"; }

# ── fixture preparation ──────────────────────────────────────────────────────
# `-` empty project, `@name` a copy from fixtures/, `reg:LINE\nLINE` a registry,
# `setup:PATH` a script that builds the box itself. The last one exists because
# a multi-line literal, a CP1251 file or a path with a space cannot be written
# on one `~`-separated line — and those are precisely where the classifier
# breaks.
prepare() {
    spec="$1"; dest="$2"
    mkdir -p "$dest"
    case "$spec" in
        -|'') : ;;
        @*)   src="$FIXTURES/${spec#@}"
              [ -d "$src" ] || { echo "no fixture $src" >&2; return 1; }
              cp -R "$src/." "$dest/" 2>/dev/null || return 1 ;;
        reg:*)
              mkdir -p "$dest/.redfirst"
              printf '%b\n' "${spec#reg:}" > "$dest/.redfirst/irreplaceable" ;;
        setup:*)
              # Exit 77 from setup.sh means "the condition could not be created
              # here" — an unreadable file cannot be made under Git Bash on
              # Windows, and chmod 000 silently does nothing. The script must
              # VERIFY the fault took and say 77 itself; guessing by platform
              # name would be the same unchecked assumption the tool exists to
              # fight. The reason it prints becomes the report line.
              [ -f "${spec#setup:}" ] || { echo "no ${spec#setup:}" >&2; return 1; }
              ( cd "$dest" && sh "${spec#setup:}" ) > "$WORK/setup.out" 2>&1
              _prep=$?
              [ "$_prep" = 77 ] && return 77
              [ "$_prep" = 0 ] || return 1 ;;
        *)    echo "unknown fixture kind: $spec" >&2; return 1 ;;
    esac
}

# ── one case in one shell ────────────────────────────────────────────────────
# Prints "ok" or a human-readable reason.
# Read-only commands share one prepared copy of each fixture instead of getting
# their own: copying the tree per case was the bulk of the runtime, and
# wired/samples/counter never write anything.
readonly_cmd() {
    case "$1" in
        wired*|samples*|counter*|--version*|NOARGS) return 0 ;;
        *) return 1 ;;
    esac
}

shared_box() {
    _key=$(printf '%s' "$1" | tr -c 'A-Za-z0-9' '_')
    _box="$WORK/shared.$_key"
    [ -d "$_box" ] && { printf '%s' "$_box"; return 0; }
    mkdir -p "$_box"
    prepare "$1" "$_box" >/dev/null 2>&1
    _sbc=$?
    [ "$_sbc" = 0 ] || { rm -rf "$_box"; return "$_sbc"; }
    printf '%s' "$_box"
}

# The reason a skip happened is the first line the setup script printed.
skip_reason() {
    _r=$(head -n 1 "$WORK/setup.out" 2>/dev/null)
    [ -n "$_r" ] || _r='the precondition cannot be reproduced on this platform'
    printf 'SKIP %s' "$_r"
}

run_one() {
    _sh="$1"; _dir="$2"; _code="$3"; _needle="$4"; _fixture="$5"; _cmd="$6"
    if readonly_cmd "$_cmd"; then
        box=$(shared_box "$_fixture")
        _bc=$?
        [ "$_bc" = 77 ] && { skip_reason; return 1; }
        [ "$_bc" = 0 ] || { printf 'fixture did not build'; return 1; }
    else
        box="$WORK/box.$$"
        rm -rf "$box"; mkdir -p "$box"
        prepare "$_fixture" "$box"
        _bc=$?
        [ "$_bc" = 77 ] && { skip_reason; return 1; }
        [ "$_bc" = 0 ] || { printf 'fixture did not build'; return 1; }
    fi

    # Streams are captured separately. Merging them hid the single property the
    # hook depends on: `due --quiet` must write to STDERR, because a SessionStart
    # hook shows stdout only on exit 0 and stderr only on any other code. With
    # 2>&1 the suite could not tell a working hook from a silent one.
    _o="$WORK/o.$$"; _e="$WORK/e.$$"
    case "$_cmd" in
        NOARGS)
            ( cd "$box" && "$_sh" "$TOOL" ) >"$_o" 2>"$_e" ;;
        # `@sh <code>` runs arbitrary shell in the box. The installer is not a
        # subcommand, and idempotence can only be shown by running twice —
        # neither fits "arguments after redfirst".
        @sh\ *)
            ( cd "$box" && RF="$TOOL" INSTALL="$ROOT/install.sh" RFROOT="$ROOT" \
              "$_sh" -c "${_cmd#@sh }" ) >"$_o" 2>"$_e" ;;
        *)
            ( cd "$box" && eval "$_sh \"\$TOOL\" $_cmd" ) >"$_o" 2>"$_e" ;;
    esac
    rc=$?

    if [ "$_code" != "*" ] && [ "$rc" != "$_code" ]; then
        printf 'code %s, expected %s' "$rc" "$_code"; return 1
    fi
    # Assertions are separated by `&&`. One report has to satisfy several claims
    # at once — a bucket number AND the arithmetic — and re-running the tool for
    # each claim costs more than the claim is worth.
    _rest_n=$_needle
    while :; do
        case $_rest_n in
            *"&&"*) _one=${_rest_n%%&&*}; _rest_n=${_rest_n#*&&} ;;
            *)      _one=$_rest_n;        _rest_n="" ;;
        esac
        trim_set "$_one"
        [ -z "$_tv" ] || check_needle "$_tv" "$_o" "$_e" || return 1
        [ -n "$_rest_n" ] || break
    done
    printf 'ok'
}

# Splitting with cut+sed cost twelve forks per line and twenty seconds per run
# on sixty lines — the same defect the tool itself had in `due`, reproduced in
# its test harness. Parameter expansion does it with none. The result lands in a
# variable instead of on stdout, because reading a helper's result through
# `$(…)` is itself a fork, and there are six fields per case line — the same
# mistake, one level smaller. Every run parses every case even when ONLY selects
# three of them, so this was paid on the self-check too: 25 s → 8 s.
_tv=""
trim_set() {
    _tv=$1
    while :; do case $_tv in [\ \	]*) _tv=${_tv#?} ;; *) break ;; esac; done
    while :; do case $_tv in *[\ \	]) _tv=${_tv%?} ;; *) break ;; esac; done
}

# $1 — field names separated by spaces, $2 — the line. A table case and the
# `expect` of a directory one differ by one field — the only difference.
split_into() {
    _names=$1; _rest=$2
    for _name in $_names; do
        case $_rest in
            *~*) _val=${_rest%%~*}; _rest=${_rest#*~} ;;
            *)   _val=$_rest;       _rest="" ;;
        esac
        trim_set "$_val"
        eval "$_name=\$_tv"
    done
}

# ── numbers out of a wired report ────────────────────────────────────────────
# The bucket breakdown IS the product: a count a non-reader can judge. Checking
# it by substring let a report with "4 matches in total" and zero in every
# bucket pass unnoticed — the arithmetic did not add up and nothing looked.
# Keys are latin: they are the tool's own internal bucket names. The labels are
# Russian because the report is.
_num=""
report_num() {
    case $1 in
        files) _lbl='files mentioning it' ;;
        code)  _lbl='of those, in code' ;;
        text)  _lbl='outside code only' ;;
        hits)  _lbl='mentions in code' ;;
        *)     _num=""; return 1 ;;
    esac
    # Anchored on the report block, not on the label alone: prose below the
    # block mentioned the same words and the parser read a number out of a
    # sentence. Bucket lines are the only ones indented by two spaces.
    _num=""
    while IFS= read -r _l; do
        case $_l in "  $_lbl"*) _num=${_l##* } ;; esac
    done < "$2"
    [ -n "$_num" ] || return 1
    case $_num in ''|*[!0-9]*) _num=""; return 1 ;; esac
    return 0
}

# ── one assertion ────────────────────────────────────────────────────────────
# Prints the reason and returns 1 when it does not hold; that print is the
# caller's return value, so no subshell is needed to carry it back.
check_needle() {
    _n=$1; _o_f=$2; _e_f=$3
    case "$_n" in
        -|'') return 0 ;;
        sum)
            for _k in files code text; do
                if ! report_num "$_k" "$_o_f"; then
                    printf 'no bucket %s in report (output starts: %s)' "$_k" \
                           "$(head -c 70 "$_o_f" 2>/dev/null | tr '\n' ' ')"
                    return 1
                fi
                eval "_v_$_k=\$_num"
            done
            _s=$((_v_code + _v_text))
            if [ "$_s" != "$_v_files" ]; then
                printf 'arithmetic does not add up: files %s, by bucket %s (%s+%s)' \
                       "$_v_files" "$_s" "$_v_code" "$_v_text"
                return 1
            fi ;;
        n:*)
            _kv=${_n#n:}; _k=${_kv%%=*}; _want=${_kv#*=}
            if ! report_num "$_k" "$_o_f"; then
                printf 'no bucket %s in report (output starts: %s)' "$_k" \
                       "$(head -c 70 "$_o_f" 2>/dev/null | tr '\n' ' ')"
                return 1
            fi
            if [ "$_num" != "$_want" ]; then
                printf 'bucket %s = %s, expected %s' "$_k" "$_num" "$_want"; return 1
            fi ;;
        err:*)
            if ! grep -qF -- "${_n#err:}" "$_e_f" 2>/dev/null; then
                printf 'no "%s" in STDERR (there: %s)' "${_n#err:}" \
                       "$(head -c 60 "$_e_f" 2>/dev/null | tr '\n' ' ')"; return 1
            fi ;;
        out:*)
            if ! grep -qF -- "${_n#out:}" "$_o_f" 2>/dev/null; then
                printf 'no "%s" in STDOUT' "${_n#out:}"; return 1
            fi ;;
        !*)
            if grep -qF -- "${_n#!}" "$_o_f" "$_e_f" 2>/dev/null; then
                printf 'forbidden "%s" found' "${_n#!}"; return 1
            fi ;;
        *)
            if ! grep -qF -- "$_n" "$_o_f" "$_e_f" 2>/dev/null; then
                printf 'no line "%s"' "$_n"; return 1
            fi ;;
    esac
    return 0
}

# ── one case, every shell, counted ───────────────────────────────────────────
# `red?` / `green?` mean the same direction plus "does not hold today, the
# defect is open". Cases for the three publication blockers are written BEFORE
# the fix; without the mark the suite goes permanently red and at that moment
# stops telling a known defect from a new regression — which is the whole of
# what a regression suite does.
#
# The mark must never become a way to hide red, so: open defects are named in
# every run, the exit code is never 0 while one is open, and a marked case that
# PASSES is a hard failure demanding the mark be removed. A stale mark is worse
# than the defect — it silences a check that already works, permanently.
tally() {
    _id=$1; _dr=$2; _cd=$3; _nd=$4; _fx=$5; _cm=$6
    _known=0
    case $_dr in *\?) _known=1; _dr=${_dr%\?} ;; esac
    first=""; verdicts=""
    for one in $SHELLS; do
        total=$((total + 1))
        why=$(run_one "$one" "$_dr" "$_cd" "$_nd" "$_fx" "$_cm")
        # A check that did not run is not a check that passed. The tool has
        # three outcomes for exactly this reason; the suite needed the same one.
        case $why in SKIP*)
            skipped=$((skipped + 1))
            skip_list="$skip_list
  $_id ($one): ${why#SKIP }"
            verdicts="$verdicts $one=skip"
            [ -z "$first" ] && first="$why"
            continue ;;
        esac
        if [ "$_known" = 1 ]; then
            if [ "$why" = "ok" ]; then
                fixed=$((fixed + 1))
                fixed_list="$fixed_list
  $_id ($one): passes — remove the "$_dr?" mark in the case file"
            else
                known=$((known + 1))
                known_list="$known_list
  $_id ($one): $why"
            fi
        elif [ "$why" = "ok" ]; then
            passed=$((passed + 1))
        elif [ "$_dr" = "red" ]; then
            blockers=$((blockers + 1))
            blocker_list="$blocker_list
  $_id ($one): $why"
        else
            noise=$((noise + 1))
            noise_list="$noise_list
  $_id ($one): $why"
        fi
        verdicts="$verdicts $one=$why"
        [ -z "$first" ] && first="$why"
        if [ "$why" != "$first" ]; then
            diffs=$((diffs + 1))
            diff_list="$diff_list
  $_id: shells diverged —$verdicts"
        fi
    done
}

# ── table cases ──────────────────────────────────────────────────────────────
run_table() {
    for file in "$CASES"/*.cases; do
        [ -f "$file" ] || continue
        while IFS= read -r line || [ -n "$line" ]; do
            case $line in ''|\#*) continue ;; esac
            split_into 'id dir code needle fixture cmd' "$line"
            [ -n "$id" ] && [ -n "$cmd" ] || continue
            case "$id" in ${ONLY:-*}) ;; *) continue ;; esac
            tally "$id" "$dir" "$code" "$needle" "$fixture" "$cmd"
        done < "$file"
    done
}

# ── directory cases ──────────────────────────────────────────────────────────
# `cases/<id>/setup.sh` builds the box; `cases/<id>/expect` holds the same
# fields minus the fixture, since the fixture is the script. The id is the
# directory name — one place, not two.
run_dirs() {
    for case_dir in "$CASES"/*/; do
        [ -d "$case_dir" ] || continue
        cdir=${case_dir%/}; cid=${cdir##*/}
        case "$cid" in ${ONLY:-*}) ;; *) continue ;; esac
        if [ ! -f "$cdir/setup.sh" ] || [ ! -f "$cdir/expect" ]; then
            printf 'case %s incomplete: need setup.sh and expect\n' "$cid" >&2
            continue
        fi
        eline=""
        while IFS= read -r l || [ -n "$l" ]; do
            case $l in ''|\#*) continue ;; esac
            eline=$l; break
        done < "$cdir/expect"
        if [ -z "$eline" ]; then
            printf 'case %s: expect is empty\n' "$cid" >&2; continue
        fi
        split_into 'dir code needle cmd' "$eline"
        if [ -z "$cmd" ]; then
            printf 'case %s: no command in expect\n' "$cid" >&2; continue
        fi
        tally "$cid" "$dir" "$code" "$needle" "setup:$cdir/setup.sh" "$cmd"
    done
}

# ── unit tests ───────────────────────────────────────────────────────────────
run_unit() {
    for file in "$UNIT"/*.sh; do
        [ -f "$file" ] || continue
        name=$(basename "$file" .sh)
        for one in $SHELLS; do
            total=$((total + 1))
            if out=$(REDFIRST_LIB=1 TOOL="$TOOL" "$one" "$file" 2>&1); then
                passed=$((passed + 1))
            else
                blockers=$((blockers + 1))
                blocker_list="$blocker_list
  unit/$name ($one): $(printf '%s' "$out" | head -n 3 | tr '\n' ' ')"
            fi
        done
    done
}

# ── self-check ───────────────────────────────────────────────────────────────
# Breaks the tool on purpose and demands the suite notices. A suite that stays
# green on a broken tool proves nothing.
#
# The list lives in a variable so that "six break points" in the documents can
# be counted from it instead of being retyped. A number nobody can compute is a
# number nobody maintains — the whole premise of this tool, applied to its own
# paperwork. Globbing is switched off while the variable is split: the patterns
# contain `*` and would otherwise be expanded against the current directory.
BREAK_POINTS='dates:due-*date*
noise:wired-only-in-test
single:wired-dead-*
quiet:due-quiet-*
strings:wired-strings-js
imports:wired-module-import-*
redgreen:redgreen-green-needs-red'

break_count() {
    _bn=0
    set -f
    for _bp in $BREAK_POINTS; do _bn=$((_bn + 1)); done
    set +f
    printf '%s' "$_bn"
}

self_check() {
    note 'redfirst tests: self-check — breaking the tool and expecting red'
    note ''
    bad=0
    _total_points=$(break_count)
    set -f
    for pair in $BREAK_POINTS; do
        set +f
        point=${pair%%:*}; pattern=${pair#*:}
        # `sh "$0"`, not `"$0"`: the executable bit does not survive authoring
        # under Windows, everything comes out of git with mode 644, and on Linux
        # a direct call gives Permission denied. The self-check meanwhile
        # reported FAIL on all five points — the mechanism that makes the suite
        # trustworthy at all had never once worked on the target platform, and
        # it blamed the tool for that.
        out=$(REDFIRST_SELFTEST=1 REDFIRST_BREAK="$point" ONLY="$pattern" \
              SHELLS=dash sh "$0" --plain 2>&1)
        got=$(printf '%s' "$out" | sed -n 's/^BLOCKERS=//p')
        [ -n "$got" ] || got=0
        if [ "$got" -gt 0 ]; then
            printf '  %-7s broken → %s went red (%s blockers)  ok\n' "$point" "$pattern" "$got"
        else
            printf '  %-7s broken → %s STAYED GREEN  FAIL\n' "$point" "$pattern"
            bad=$((bad + 1))
        fi
    done
    note ''
    if [ "$bad" -gt 0 ]; then
        note "Self-check failed on $bad of $_total_points points. The suite cannot be trusted."
        exit 3
    fi
    note "Self-check passed: the suite catches the break at each of $_total_points points."
    exit 0
}

# ── when the suite last passed on each machine ───────────────────────────────
# The suite is never complete on any one machine alone: under Windows an
# unreadable path cannot be created, under Linux — POSIX emulation over Windows.
# So the question "was it run where the rest gets checked" is asked on every
# run, and it must not be answered from memory.
#
# Debt D7 asked to make a run on the target machine a habit and named the
# condition for revisiting itself: "if a regression ever lives there unnoticed".
# On 2026-08-17 that happened twice in one night. A habit cannot be programmed,
# a date can: it shows in every run and ages before your eyes.
LASTRUN="$HERE/last-run"

record_run() {
    # `uname -s` under Git Bash gives MINGW64_NT-10.0-26200 — a kernel version
    # in the machine name makes the line unreadable and changes from update to
    # update, i.e. the record would disagree with itself.
    _plat=$(uname -s 2>/dev/null | sed 's/[-_].*//' || echo unknown)
    [ -n "$_plat" ] || _plat=unknown
    _tmpf="$LASTRUN.new.$$"
    {
        if [ -f "$LASTRUN" ]; then grep -v "	$_plat	" "$LASTRUN" || true; fi
        printf '%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%d)" "$_plat" "$total" "$skipped"
    } > "$_tmpf" 2>/dev/null && mv -f "$_tmpf" "$LASTRUN" 2>/dev/null || rm -f "$_tmpf"
    return 0
}

show_runs() {
    note ''
    if [ ! -f "$LASTRUN" ]; then
        note 'No clean run has been recorded at all.'
        return 0
    fi
    note 'Last run with nothing broken, by machine:'
    while IFS='	' read -r _d _p _n _s || [ -n "$_p" ]; do
        [ -n "$_p" ] || continue
        printf '  %s  %-10s %s checks, %s not run\n' "$_d" "$_p" "$_n" "$_s"
    done < "$LASTRUN"
    note 'What one machine skips is checked on another — and only there.'
    return 0
}

# ── counting without a run ───────────────────────────────────────────────────
# The numbers describing the suite in README and DEBTS.md are taken from here,
# not retyped by hand. Counted by the same rules as a run — otherwise there
# would be a second counter diverging from the first, and it is that one you
# would end up reconciling. Cases are not run: the mode costs a split second.
count_only() {
    _t=0
    for file in "$CASES"/*.cases; do
        [ -f "$file" ] || continue
        while IFS= read -r line || [ -n "$line" ]; do
            case $line in ''|\#*) continue ;; esac
            split_into 'id dir code needle fixture cmd' "$line"
            [ -n "$id" ] && [ -n "$cmd" ] || continue
            _t=$((_t + 1))
        done < "$file"
    done
    _d=0
    for case_dir in "$CASES"/*/; do
        [ -d "$case_dir" ] || continue
        [ -f "$case_dir/setup.sh" ] && [ -f "$case_dir/expect" ] && _d=$((_d + 1))
    done
    _u=0
    for file in "$UNIT"/*.sh; do
        [ -f "$file" ] || continue
        _u=$((_u + 1))
    done
    _s=0
    for one in $SHELLS; do _s=$((_s + 1)); done
    printf 'cases-table=%s\n' "$_t"
    printf 'cases-dir=%s\n'   "$_d"
    printf 'units=%s\n'       "$_u"
    printf 'shells=%s\n'      "$_s"
    printf 'cases=%s\n'       "$((_t + _d))"
    printf 'checks=%s\n'      "$(( (_t + _d + _u) * _s ))"
    printf 'breaks=%s\n'      "$(break_count)"
    printf 'tool-lines=%s\n'  "$(grep -c '' "$TOOL")"
}

case "${1:-}" in
    --self-check) self_check ;;
    --count)      count_only; exit 0 ;;
    --plain)      PLAIN=1 ;;
    '')           PLAIN=0 ;;
    *)            echo "usage: run [--self-check|--count]" >&2; exit 3 ;;
esac

run_table
run_dirs
[ -z "${ONLY:-}" ] && run_unit

if [ "${PLAIN:-0}" = "1" ]; then
    printf 'BLOCKERS=%s\n' "$blockers"
    exit 0
fi

note ""
note "redfirst tests: shells:$SHELLS"
note ""
printf '  BLOCKERS (the tool missed a defect)             %s\n' "$blockers"
printf '  NOISE (complained for nothing)                  %s\n' "$noise"
printf '  SHELL DIVERGENCES                               %s\n' "$diffs"
printf '  KNOWN OPEN DEFECTS                              %s\n' "$known"
printf '  NOT CHECKED (precondition could not be created) %s\n' "$skipped"
[ "$fixed" -gt 0 ] && printf '  FIXED, the mark is stale                        %s\n' "$fixed"
printf '  passed                                          %s of %s\n' "$passed" "$total"
[ -n "$blocker_list" ] && { note ""; note "BLOCKERS:$blocker_list"; }
[ -n "$noise_list" ]   && { note ""; note "NOISE:$noise_list"; }
[ -n "$diff_list" ]    && { note ""; note "DIVERGENCES:$diff_list"; }
[ -n "$known_list" ]   && { note ""; note "OPEN DEFECTS (expected to fail):$known_list"; }
[ -n "$fixed_list" ]   && { note ""; note "STALE MARK:$fixed_list"; }
[ -n "$skip_list" ]    && { note ""; note "NOT CHECKED:$skip_list"; }
note ""

[ "$fixed" -gt 0 ] && {
    note 'A case marked "open" passes. Until the mark is removed, this check'
    note 'guards nothing: it will stay silent when the defect comes back too.'
    exit 2
}
[ "$blockers" -gt 0 ] || [ "$diffs" -gt 0 ] && exit 2
[ "$known" -gt 0 ] && {
    note "No regressions. Open defects: $known — listed above, waiting to be fixed."
    exit 1
}
[ "$noise" -gt 0 ] && exit 1
# The date is recorded only for a full run: `ONLY` drives a subset, and a record
# of it would read as "everything here is fine".
[ -z "${ONLY:-}" ] && record_run
# The word "Clean" is not available when something did not run. Exit code
# answers "did anything break"; this line answers "was everything checked".
# Same precedent as the missing-dash warning: an unavailable dimension is loud
# and does not change the code.
if [ "$skipped" -gt 0 ]; then
    note "Nothing is broken, but $skipped checks did not run — they are listed above."
    note "Their precondition cannot be created on this platform. The suite is full only where it can."
    show_runs
    exit 0
fi
note "Clean. Now run $0 --self-check — a suite without a self-check proves nothing."
exit 0
